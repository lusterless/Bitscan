[Unit]
Description=Bitscan read-only capability helper
Requires=bitscan-capread.socket

[Service]
ExecStart=/usr/sbin/bitscan-capread --serve
# Not root: a throwaway user with only the two read capabilities it needs
DynamicUser=yes
AmbientCapabilities=CAP_NET_ADMIN CAP_AUDIT_CONTROL
CapabilityBoundingSet=CAP_NET_ADMIN CAP_AUDIT_CONTROL
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
