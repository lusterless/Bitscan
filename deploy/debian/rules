#!/usr/bin/make -f
# Binary-only packaging of prebuilt static binaries (PD-26). The staging tree
# made by build-deb.sh holds bin/ (the three binaries), clustermax/ (the
# ClusterMAX collector from collector/packaging/stage.sh), debian/systemd/ (the
# five agent units and the two cmax-helper units of TS 3.8, verbatim TS 3.7 except RemoveOnStop=yes in
# bitscan-capread.socket, decisions 2026-10-26) and debian/dbus/ (the D-Bus
# policy).

UNITDIR := debian/bitscan-agent/lib/systemd/system

%:
	dh $@

# The binaries are built before packaging, with reproducible Go flags.
override_dh_auto_build:

# Units are copied unchanged from deploy/systemd/.
execute_after_dh_install:
	install -d $(UNITDIR)
	install -m 0644 debian/systemd/bitscan-agent.service $(UNITDIR)/
	install -m 0644 debian/systemd/bitscan-runner.socket $(UNITDIR)/
	install -m 0644 debian/systemd/bitscan-runner.service $(UNITDIR)/
	install -m 0644 debian/systemd/bitscan-capread.socket $(UNITDIR)/
	install -m 0644 debian/systemd/bitscan-capread.service $(UNITDIR)/
	install -m 0644 debian/systemd/cmax-helper.socket $(UNITDIR)/
	install -m 0644 debian/systemd/cmax-helper.service $(UNITDIR)/

# TS 3.1: --no-enable for the runner service (its socket starts it). The
# ClusterMAX collector socket (TS 3.8, owner decision 2026-11-15) and the
# capread socket (TS 3.7, owner decision 2026-11-16) are enabled and started
# on every host; their services are started by the sockets. postinst snippets
# run in call order, so the helper sockets start before bitscan-agent.service
# and the agent's first heartbeat reports them (TS 3.1 postinst step 4).
override_dh_installsystemd:
	dh_installsystemd cmax-helper.socket
	dh_installsystemd --no-enable cmax-helper.service
	dh_installsystemd bitscan-capread.socket
	dh_installsystemd --no-enable bitscan-capread.service
	dh_installsystemd bitscan-agent.service bitscan-runner.socket
	dh_installsystemd --no-enable bitscan-runner.service

# Static Go binaries are built with -s -w: nothing to strip or compress.
override_dh_strip:

override_dh_dwz:
