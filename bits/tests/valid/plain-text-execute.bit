<?xml version="1.0" encoding="UTF-8"?>
<!-- bits/tests fixture valid/plain-text-execute: Execute as plain text with entity escapes, and CDATA plus text joined -->
<Policy formatVersion="1.0">
  <PolicyName>Fixture valid/plain-text-execute</PolicyName>
  <PolicyDescription>Bitscan test fixture.</PolicyDescription>
  <PolicyStatus>enabled</PolicyStatus>
  <Family>
    <FamilyName>Bitscan Test Family</FamilyName>
  </Family>
  <PluginsGroups>
    <Plugin>
      <PluginName>1.1 - Fixture check 1</PluginName>
      <PluginDescription>Fixture plugin 1.</PluginDescription>
      <PluginId>18253e40-b856-5203-b1ce-a3dc04e17b59</PluginId>
      <Execute timeout="30">test -f /etc/issue &amp;&amp; stat -c %a /etc/issue 2&gt;/dev/null</Execute>
      <Operator>equals</Operator>
      <ExpectedResult>install ok installed</ExpectedResult>
    </Plugin>
    <Plugin>
      <PluginName>2.1 - Fixture check 2</PluginName>
      <PluginDescription>Fixture plugin 2.</PluginDescription>
      <PluginId>e73b979b-cd39-57e9-bf59-1073d13980ad</PluginId>
      <Execute timeout="30">dpkg-query -W <![CDATA[-f='${Status}']]> apparmor</Execute>
      <Operator>equals</Operator>
      <ExpectedResult>install ok installed</ExpectedResult>
    </Plugin>
  </PluginsGroups>
</Policy>
