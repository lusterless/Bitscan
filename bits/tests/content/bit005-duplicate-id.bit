<?xml version="1.0" encoding="UTF-8"?>
<!-- bits/tests fixture content/bit005-duplicate-id: two plugins with one PluginId: BIT005 on the second -->
<Policy formatVersion="1.0">
  <PolicyName>Fixture content/bit005-duplicate-id</PolicyName>
  <PolicyDescription>Bitscan test fixture.</PolicyDescription>
  <PolicyStatus>enabled</PolicyStatus>
  <Family>
    <FamilyName>Bitscan Test Family</FamilyName>
  </Family>
  <PluginsGroups>
    <Plugin>
      <PluginName>1.1 - Fixture check 1</PluginName>
      <PluginDescription>Fixture plugin 1.</PluginDescription>
      <PluginId>b0e94a0e-e567-5dfc-9c07-bd541487a8f8</PluginId>
      <Execute timeout="30"><![CDATA[dpkg-query -W -f='${Status}' apparmor 2>/dev/null]]></Execute>
      <Operator>equals</Operator>
      <ExpectedResult>install ok installed</ExpectedResult>
    </Plugin>
    <Plugin>
      <PluginName>2.1 - Fixture check 2</PluginName>
      <PluginDescription>Fixture plugin 2.</PluginDescription>
      <PluginId>b0e94a0e-e567-5dfc-9c07-bd541487a8f8</PluginId>
      <Execute timeout="30"><![CDATA[dpkg-query -W -f='${Status}' apparmor 2>/dev/null]]></Execute>
      <Operator>equals</Operator>
      <ExpectedResult>install ok installed</ExpectedResult>
    </Plugin>
  </PluginsGroups>
</Policy>
