<!-- bits/tests fixture bit002/duplicate-ExpectedResult: required element ExpectedResult twice -->
<Policy formatVersion="1.0">
  <PolicyName>Fixture bit002/duplicate-ExpectedResult</PolicyName>
  <PolicyDescription>Bitscan test fixture.</PolicyDescription>
  <PolicyStatus>enabled</PolicyStatus>
  <Family>
    <FamilyName>Bitscan Test Family</FamilyName>
  </Family>
  <PluginsGroups>
    <Plugin>
      <PluginName>1.1 - Fixture check 1</PluginName>
      <PluginDescription>Fixture plugin 1.</PluginDescription>
      <PluginId>1ee99f97-6b04-5e6f-b8c5-fbdce28fda87</PluginId>
      <Execute timeout="30"><![CDATA[dpkg-query -W -f='${Status}' apparmor 2>/dev/null]]></Execute>
      <Operator>equals</Operator>
      <ExpectedResult>install ok installed</ExpectedResult>
      <ExpectedResult>install ok installed</ExpectedResult>
    </Plugin>
  </PluginsGroups>
</Policy>
