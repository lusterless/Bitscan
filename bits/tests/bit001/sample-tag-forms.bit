<?xml version="1.0" encoding="UTF-8"?>
<!-- bits/tests fixture bit001/sample-tag-forms: the TS §1.4 sample tag forms -->
<Policy>
  <Policy Name>CIS Ubuntu 24.04 Level 1 - Server</Policy Name>
  <Policy Description>CIS Benchmark Level 1</Policy Description>
  <Policy Status>enabled</Policy Status>
  <Family><Family Name>CIS Ubuntu 24.04</Family Name></Family>
  <Plugins Groups>
    <Plugin>
      <Plugin Name>1.3.1.1 - Ensure AppArmor is installed</Plugin Name>
      <Plugin ID>3f6c2a9e-8b1d-4e57-9a3c-2d7f0e6b1c48</Plugin ID>
      <Execute>dpkg-query -W apparmor</Execute>
      <Operator>equals</Operator>
      <Expected Result>install ok installed</Expected Result>
    </Plugin>
  </Plugins Groups>
</Policy>
