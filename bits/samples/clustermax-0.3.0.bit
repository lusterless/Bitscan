<?xml version="1.0" encoding="UTF-8"?>
<Policy formatVersion="1.0">
  <PolicyName>ClusterMAX 0.3.0 audit checks</PolicyName>
  <PolicyDescription>The 81 checks of ClusterMAX 0.3.0 (lusterless/clustermax f849f46, cmax audit -vvv -y). Needs the clustermax-collector package on the host (Technical Specification 3.8); without it every plugin prints NOHELPER and fails. Every scan runs a fresh audit: the first plugin of the scan's job on a host starts one root ClusterMAX audit through cmax-helper, and every plugin of that job reads its own line from that audit's report, which is kept only in the helper's memory. ClusterMAX PASS and SKIPPED (printed as n/a) pass; WARNING and FAIL fail. With -y, ClusterMAX auto-detects standalone, Slurm or Kubernetes on each targeted host, so target only the hosts that should run it, for example with a dedicated tag.</PolicyDescription>
  <PolicyStatus>enabled</PolicyStatus>
  <Family>
    <FamilyName>Clustermax</FamilyName>
  </Family>
  <PluginsGroups>
    <Plugin>
      <PluginName>0.1 - collect - Run the ClusterMAX audit</PluginName>
      <PluginDescription>Asks cmax-helper to run cmax audit -vvv -y as root for this scan, unless an audit is already running, which this scan then shares. Prints started or running with the run id every plugin of this scan reads; NOHELPER when the collector package is not installed.</PluginDescription>
      <PluginId>3bde17c0-474e-4333-a5f5-d5f3572b4501</PluginId>
      <Execute timeout="30"><![CDATA[
        cmax-trigger collect
      ]]></Execute>
      <Operator>regex</Operator>
      <ExpectedResult>^(started|running) [0-9a-f]{32}$</ExpectedResult>
    </Plugin>
    <Plugin>
      <PluginName>0.2 - header - ClusterMAX target</PluginName>
      <PluginDescription>Waits for the audit and prints the target block ClusterMAX reported: command, target, host, system, access and selection. Evidence of what ran on this host.</PluginDescription>
      <PluginId>713b6874-6bc0-461e-8041-8cfecd21d586</PluginId>
      <Execute timeout="600"><![CDATA[
        cmax-trigger get header
      ]]></Execute>
      <Operator>regex</Operator>
      <ExpectedResult>^Command: cmax audit; </ExpectedResult>
    </Plugin>
    <Plugin>
      <PluginName>0.3 - status - ClusterMAX run status and version</PluginName>
      <PluginDescription>Waits for the audit, then prints ok &lt;age-seconds&gt; &lt;cmax-version&gt;. Passes only when the audit finished without error and the installed ClusterMAX is 0.3.0.</PluginDescription>
      <PluginId>6e01db1d-354f-4a8c-a2e3-5d8596e013a7</PluginId>
      <Execute timeout="600"><![CDATA[
        cmax-trigger get header >/dev/null; cmax-trigger get status
      ]]></Execute>
      <Operator>regex</Operator>
      <ExpectedResult>^ok [0-9]+ 0\.3\.0$</ExpectedResult>
    </Plugin>
    <Plugin>
      <PluginName>1.1 - securityVersions.amdDriver.status - Security Versions / Amd Driver</PluginName>
      <PluginDescription>ClusterMAX 0.3.0 check securityVersions.amdDriver.status (Minimum versions). Prints the ClusterMAX verdict and its Observed value from this host's report. PASS and SKIPPED (n/a) pass; WARNING and FAIL fail; MISSING, ERROR, TIMEOUT or NOHELPER fail.</PluginDescription>
      <PluginId>4614077c-28a8-4fd0-8a47-ed18c329b60a</PluginId>
      <Execute timeout="600"><![CDATA[
        cmax-trigger get securityVersions.amdDriver.status
