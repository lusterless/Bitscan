  no_cgroups=$(grep -E '^\s*no-cgroups\s*=' "$nct_conf" 2>/dev/null | tail -1 | grep -oE '(true|false)')
  if [ "$no_cgroups" = "true" ]; then item FAIL "no-cgroups=true"
  else item OK "no-cgroups=${no_cgroups:-false(default)}"; fi
  dbg=$(grep -E '^\s*debug\s*=' "$nct_conf" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d ' "')
  [ -n "$dbg" ] && item INFO "runtime debug log=$dbg"
else
  item INFO "$nct_conf=not found"
fi
out "no result"
  ]]></Execute>
  <Operator>regex</Operator>
  <ExpectedResult>^(OK|INFO|n/a)( |$)</ExpectedResult>
</Plugin>
<Plugin>
  <PluginName>30.9.2 - GPU compute mode</PluginName>
  <PluginDescription>Script item 30, sub-section 30.9.2. Source: gpu_baseline_check_2.sh:2966-2978 (main_30_33.sh:409-421). nvidia-smi --query-gpu=compute_mode: any Exclusive_Process -&gt; OK, else WARN. No nvidia-smi output -&gt; the script prints nothing -&gt; n/a. Verdict = worst result in this sub-section, FAIL &gt; WARN &gt; OK &gt; INFO; the WARN/FAIL lines the script adds to item 30's issues/warns are included. Gate (script lines 28-40): no /proc/driver/nvidia, no nvidia-smi, no /dev/nvidia[0-9]*, no NVIDIA 3D/VGA in lspci -&gt; 'n/a no NVIDIA GPU' (script: PASS, skip item 30). Output: '&lt;OK|INFO|WARN|FAIL|n/a&gt; &lt;observed&gt;'. WARN fails in Bitscan. Changed 2026-11-18: non-exclusive mode is INFO (whole-node bare metal); silent nvidia-smi gives WARN UNVERIFIED.</PluginDescription>
  <PluginId>a171f45a-e26b-4e86-ab09-3b812b7f44e0</PluginId>
  <Execute timeout="60"><![CDATA[
_ver_num() { printf '%s\n' "${1:-}" | grep -oE '[0-9]+(\.[0-9]+)*' | head -1; }
_ver_ge() {
  _a=$(_ver_num "${1:-}"); _b=$(_ver_num "${2:-}")
  if [ -z "$_a" ] || [ -z "$_b" ]; then return 1; fi
  [ "$_a" = "$_b" ] && return 0
  [ "$(printf '%s\n%s\n' "$_a" "$_b" | sort -V | head -1)" = "$_b" ]
}
V=""; D=""
item() {
  case "$1" in
    FAIL) V=FAIL ;;
    WARN) [ "$V" = FAIL ] || V=WARN ;;
    OK) case "$V" in FAIL|WARN) ;; *) V=OK ;; esac ;;
    INFO) [ -n "$V" ] || V=INFO ;;
  esac
  [ -n "${2:-}" ] && D="${D:+$D; }$2"
  return 0
}
out() {
  if [ -z "$V" ]; then printf 'n/a %s\n' "$1" | tr -s ' '
  else printf '%s %s\n' "$V" "$(printf '%s' "$D" | tr '\n' ' ' | tr -s ' ')"; fi
}
has_gpu=false
if [ -d /proc/driver/nvidia ] || command -v nvidia-smi >/dev/null 2>&1; then has_gpu=true; fi
if ! $has_gpu; then
  for f in /dev/nvidia[0-9]*; do if [ -e "$f" ]; then has_gpu=true; break; fi; done
fi
if ! $has_gpu && lspci 2>/dev/null | grep -qi 'NVIDIA.*\(3D controller\|VGA compatible\)'; then has_gpu=true; fi
if ! $has_gpu; then echo "n/a no NVIDIA GPU"; exit 0; fi
compute_modes=$(nvidia-smi --query-gpu=compute_mode --format=csv,noheader 2>/dev/null | sort -u | tr '\n' ' ')
if [ -n "$compute_modes" ]; then
  if echo "$compute_modes" | grep -q "Exclusive_Process"; then item OK "compute_mode=$compute_modes"
  else item INFO "compute_mode=$compute_modes (Exclusive_Process matters only when GPUs are shared)"; fi
fi
if [ -z "$compute_modes" ] && command -v nvidia-smi >/dev/null 2>&1; then item WARN "UNVERIFIED nvidia-smi returned no compute_mode"; fi
out "no compute_mode from nvidia-smi"
  ]]></Execute>
  <Operator>regex</Operator>
  <ExpectedResult>^(OK|INFO|n/a)( |$)</ExpectedResult>
</Plugin>
