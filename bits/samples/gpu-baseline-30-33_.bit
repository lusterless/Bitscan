}
has_gpu=false
if [ -d /proc/driver/nvidia ] || command -v nvidia-smi >/dev/null 2>&1; then has_gpu=true; fi
if ! $has_gpu; then
  for f in /dev/nvidia[0-9]*; do if [ -e "$f" ]; then has_gpu=true; break; fi; done
fi
if ! $has_gpu && lspci 2>/dev/null | grep -qi 'NVIDIA.*\(3D controller\|VGA compatible\)'; then has_gpu=true; fi
if ! $has_gpu; then echo "n/a no NVIDIA GPU"; exit 0; fi
if [ -r /etc/docker/daemon.json ]; then
  if grep -qE '"default-runtime"\s*:\s*"nvidia"' /etc/docker/daemon.json 2>/dev/null; then
    item WARN "default-runtime=nvidia"
  fi
