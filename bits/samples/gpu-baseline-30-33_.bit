<Plugin>
  <PluginName>30.9.5 - Privileged or dangerous-capability containers</PluginName>
  <PluginDescription>Script item 30, sub-section 30.9.5. Source: gpu_baseline_check_2.sh:3009-3030 (main_30_33.sh:452-473). When docker info works: docker inspect of up to 50 running containers; Privileged=true or CapAdd matching SYS_ADMIN|SYS_MODULE|SYS_RAWIO|ALL (case-insensitive, whole inspect line) -&gt; FAIL, none -&gt; OK. docker missing or not reachable -&gt; n/a. Verdict = worst result in this sub-section, FAIL &gt; WARN &gt; OK &gt; INFO; the WARN/FAIL lines the script adds to item 30's issues/warns are included. Gate (script lines 28-40): no /proc/driver/nvidia, no nvidia-smi, no /dev/nvidia[0-9]*, no NVIDIA 3D/VGA in lspci -&gt; 'n/a no NVIDIA GPU' (script: PASS, skip item 30). Output: '&lt;OK|INFO|WARN|FAIL|n/a&gt; &lt;observed&gt;'. WARN fails in Bitscan. Changed 2026-11-18: a docker socket that the runner cannot query gives WARN UNVERIFIED instead of n/a.</PluginDescription>
  <PluginId>5c9ceb8e-f9c5-4659-92de-2e493fe1f04e</PluginId>
  <Execute timeout="120"><![CDATA[
_ver_num() { printf '%s\n' "${1:-}" | grep -oE '[0-9]+(\.[0-9]+)*' | head -1; }
_ver_ge() {
  _a=$(_ver_num "${1:-}"); _b=$(_ver_num "${2:-}")
  if [ -z "$_a" ] || [ -z "$_b" ]; then return 1; fi
  [ "$_a" = "$_b" ] && return 0
  [ "$(printf '%s\n%s\n' "$_a" "$_b" | sort -V | head -1)" = "$_b" ]
}
V=""; D=""
item() {
  case "$1" in
    FAIL) V=FAIL ;;
    WARN) [ "$V" = FAIL ] || V=WARN ;;
    OK) case "$V" in FAIL|WARN) ;; *) V=OK ;; esac ;;
    INFO) [ -n "$V" ] || V=INFO ;;
  esac
  [ -n "${2:-}" ] && D="${D:+$D; }$2"
  return 0
}
out() {
  if [ -z "$V" ]; then printf 'n/a %s\n' "$1" | tr -s ' '
  else printf '%s %s\n' "$V" "$(printf '%s' "$D" | tr '\n' ' ' | tr -s ' ')"; fi
}
has_gpu=false
if [ -d /proc/driver/nvidia ] || command -v nvidia-smi >/dev/null 2>&1; then has_gpu=true; fi
if ! $has_gpu; then
  for f in /dev/nvidia[0-9]*; do if [ -e "$f" ]; then has_gpu=true; break; fi; done
fi
if ! $has_gpu && lspci 2>/dev/null | grep -qi 'NVIDIA.*\(3D controller\|VGA compatible\)'; then has_gpu=true; fi
if ! $has_gpu; then echo "n/a no NVIDIA GPU"; exit 0; fi
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  priv=""
  for cid in $(docker ps -q 2>/dev/null | head -50); do
    cinfo=$(docker inspect --format '{{.Name}}|{{.HostConfig.Privileged}}|{{range .HostConfig.CapAdd}}{{.}} {{end}}' "$cid" 2>/dev/null)
    [ -z "$cinfo" ] && continue
    case "$cinfo" in
      *"|true|"*) priv="$priv${cinfo%%|*} " ;;
      *) if echo "$cinfo" | grep -qiE 'SYS_ADMIN|SYS_MODULE|SYS_RAWIO|ALL'; then priv="$priv${cinfo%%|*}(dangerous-cap) "; fi ;;
    esac
  done
  if [ -n "$priv" ]; then item FAIL "privileged/dangerous-cap containers=$priv"
  else item OK "privileged/dangerous-cap containers=none"; fi
fi
if command -v docker >/dev/null 2>&1 && { [ -S /run/docker.sock ] || [ -S /var/run/docker.sock ]; } && ! docker info >/dev/null 2>&1; then
  item WARN "UNVERIFIED docker socket present but docker info failed (runner access?)"
fi
out "docker info unavailable"
  ]]></Execute>
  <Operator>regex</Operator>
  <ExpectedResult>^(OK|INFO|n/a)( |$)</ExpectedResult>
</Plugin>
<Plugin>
  <PluginName>31.1 - Secure Boot</PluginName>
  <PluginDescription>Script item 31, sub-section 31.1. Source: gpu_baseline_check_2.sh:3095-3145 (main_30_33.sh:538-588). No /sys/firmware/efi (Legacy BIOS) -&gt; FAIL. UEFI: mokutil --sb-state, else byte 5 of efivars SecureBoot-*: enabled -&gt; OK, disabled -&gt; FAIL, unknown -&gt; WARN. Verdict = worst result in this sub-section, FAIL &gt; WARN &gt; OK &gt; INFO. Gate (script lines 524-532 and detect_platform): systemd-detect-virt (else /sys/hypervisor/type, else unknown) not 'none'/'unknown' -&gt; 'n/a VM (&lt;type&gt;)' (script: PASS, skip item 31). Output: '&lt;OK|INFO|WARN|FAIL|n/a&gt; &lt;observed&gt;'. WARN fails in Bitscan. Changed 2026-11-18: systemd-detect-virt --vm (a container is no longer reported as a VM); adds module signature enforcement and kernel lockdown as INFO.</PluginDescription>
  <PluginId>3c602252-8357-4448-a57f-a4e1650b8dd8</PluginId>
  <Execute timeout="60"><![CDATA[
_ver_num() { printf '%s\n' "${1:-}" | grep -oE '[0-9]+(\.[0-9]+)*' | head -1; }
_ver_ge() {
  _a=$(_ver_num "${1:-}"); _b=$(_ver_num "${2:-}")
  if [ -z "$_a" ] || [ -z "$_b" ]; then return 1; fi
  [ "$_a" = "$_b" ] && return 0
  [ "$(printf '%s\n%s\n' "$_a" "$_b" | sort -V | head -1)" = "$_b" ]
}
V=""; D=""
item() {
  case "$1" in
    FAIL) V=FAIL ;;
    WARN) [ "$V" = FAIL ] || V=WARN ;;
    OK) case "$V" in FAIL|WARN) ;; *) V=OK ;; esac ;;
    INFO) [ -n "$V" ] || V=INFO ;;
  esac
  [ -n "${2:-}" ] && D="${D:+$D; }$2"
  return 0
}
out() {
  if [ -z "$V" ]; then printf 'n/a %s\n' "$1" | tr -s ' '
  else printf '%s %s\n' "$V" "$(printf '%s' "$D" | tr '\n' ' ' | tr -s ' ')"; fi
}
if command -v systemd-detect-virt >/dev/null 2>&1; then
  VIRT_TYPE=$(systemd-detect-virt --vm 2>/dev/null) || VIRT_TYPE="none"
elif [ -r /sys/hypervisor/type ]; then
  VIRT_TYPE=$(cat /sys/hypervisor/type 2>/dev/null)
else
  VIRT_TYPE="unknown"
fi
[ -z "$VIRT_TYPE" ] && VIRT_TYPE="unknown"
if [ "$VIRT_TYPE" != "none" ] && [ "$VIRT_TYPE" != "unknown" ]; then echo "n/a VM ($VIRT_TYPE)"; exit 0; fi
boot_mode="Legacy BIOS"
[ -d /sys/firmware/efi ] && boot_mode="UEFI"
if [ "$boot_mode" != "UEFI" ]; then
  item FAIL "boot=Legacy BIOS, no Secure Boot"
else
  sb_state="unknown"
  if command -v mokutil >/dev/null 2>&1; then
    sb_out=$(mokutil --sb-state 2>/dev/null)
    if echo "$sb_out" | grep -qi "SecureBoot enabled"; then sb_state="enabled"
    elif echo "$sb_out" | grep -qi "SecureBoot disabled"; then sb_state="disabled"; fi
  fi
  if [ "$sb_state" = "unknown" ] && [ -d /sys/firmware/efi/efivars ]; then
    sb_var=$(find /sys/firmware/efi/efivars -maxdepth 1 -name 'SecureBoot-*' 2>/dev/null | head -1)
    if [ -n "$sb_var" ]; then
      sb_byte=$(od -An -t u1 -j 4 -N 1 "$sb_var" 2>/dev/null | tr -d ' ')
      [ "$sb_byte" = "1" ] && sb_state="enabled"
      [ "$sb_byte" = "0" ] && sb_state="disabled"
    fi
  fi
  case "$sb_state" in
    enabled)  item OK "boot=UEFI secureboot=enabled" ;;
    disabled) item FAIL "boot=UEFI secureboot=disabled" ;;
    *)        item WARN "boot=UEFI secureboot=unconfirmed" ;;
  esac
fi
sig=$(cat /sys/module/module/parameters/sig_enforce 2>/dev/null)
[ -n "$sig" ] && item INFO "module.sig_enforce=$sig"
[ -r /sys/kernel/security/lockdown ] && item INFO "lockdown=$(cat /sys/kernel/security/lockdown 2>/dev/null)"
out "no result"
  ]]></Execute>
  <Operator>regex</Operator>
  <ExpectedResult>^(OK|INFO|n/a)( |$)</ExpectedResult>
</Plugin>
<Plugin>
  <PluginName>31.2 - Secure Host (ConnectX/BlueField firmware signing)</PluginName>
  <PluginDescription>Script item 31, sub-section 31.2. Source: gpu_baseline_check_2.sh:3064-3230 (main_30_33.sh:507-673). Devices from /dev/mst/*pciconf*|*pci_cr*, else lspci -Dn vendor 15b3; none -&gt; n/a. No flint/mstflint -&gt; WARN. Per device 'timeout 30 flint -d &lt;dev&gt; q': FW Version below train minimum (28&gt;=28.47.02, 32&gt;=32.19.08, 35&gt;=35.80.02, 39&gt;=39.80.02, 43&gt;=43.80.02, 46&gt;=46.30.08) -&gt; FAIL, other train -&gt; INFO; Security Attributes secure-fw without dev/debug/debug-token -&gt; OK, secure-fw with them -&gt; FAIL, signed-fw -&gt; FAIL, other -&gt; FAIL, missing -&gt; WARN. Verdict = worst result in this sub-section, FAIL &gt; WARN &gt; OK &gt; INFO. Gate (script lines 524-532 and detect_platform): systemd-detect-virt (else /sys/hypervisor/type, else unknown) not 'none'/'unknown' -&gt; 'n/a VM (&lt;type&gt;)' (script: PASS, skip item 31). Output: '&lt;OK|INFO|WARN|FAIL|n/a&gt; &lt;observed&gt;'. WARN fails in Bitscan. Changed 2026-11-18: an empty flint answer gives WARN UNVERIFIED with the likely cause; systemd-detect-virt --vm.</PluginDescription>
  <PluginId>40c5add4-9094-4cd3-b883-3d6dee4bb12d</PluginId>
  <Execute timeout="600"><![CDATA[
_ver_num() { printf '%s\n' "${1:-}" | grep -oE '[0-9]+(\.[0-9]+)*' | head -1; }
_ver_ge() {
  _a=$(_ver_num "${1:-}"); _b=$(_ver_num "${2:-}")
  if [ -z "$_a" ] || [ -z "$_b" ]; then return 1; fi
  [ "$_a" = "$_b" ] && return 0
  [ "$(printf '%s\n%s\n' "$_a" "$_b" | sort -V | head -1)" = "$_b" ]
}
V=""; D=""
item() {
  case "$1" in
    FAIL) V=FAIL ;;
    WARN) [ "$V" = FAIL ] || V=WARN ;;
    OK) case "$V" in FAIL|WARN) ;; *) V=OK ;; esac ;;
    INFO) [ -n "$V" ] || V=INFO ;;
  esac
  [ -n "${2:-}" ] && D="${D:+$D; }$2"
  return 0
}
out() {
  if [ -z "$V" ]; then printf 'n/a %s\n' "$1" | tr -s ' '
  else printf '%s %s\n' "$V" "$(printf '%s' "$D" | tr '\n' ' ' | tr -s ' ')"; fi
}
if command -v systemd-detect-virt >/dev/null 2>&1; then
  VIRT_TYPE=$(systemd-detect-virt --vm 2>/dev/null) || VIRT_TYPE="none"
elif [ -r /sys/hypervisor/type ]; then
  VIRT_TYPE=$(cat /sys/hypervisor/type 2>/dev/null)
else
  VIRT_TYPE="unknown"
fi
[ -z "$VIRT_TYPE" ] && VIRT_TYPE="unknown"
if [ "$VIRT_TYPE" != "none" ] && [ "$VIRT_TYPE" != "unknown" ]; then echo "n/a VM ($VIRT_TYPE)"; exit 0; fi
_mlx_fw_min() {
  case "$1" in
    28) echo "28.47.02" ;;
    32) echo "32.19.08" ;;
    35) echo "35.80.02" ;;
    39) echo "39.80.02" ;;
    43) echo "43.80.02" ;;
    46) echo "46.30.08" ;;
  esac
}
flint_bin=""
if command -v flint >/dev/null 2>&1; then flint_bin="flint"
elif command -v mstflint >/dev/null 2>&1; then flint_bin="mstflint"; fi
mlx_devs=""
for f in /dev/mst/*; do
  if [ -e "$f" ]; then mlx_devs=$(ls /dev/mst/* 2>/dev/null | grep -E 'pciconf|pci_cr' | tr '\n' ' '); break; fi
done
if [ -z "$mlx_devs" ]; then
  mlx_devs=$(lspci -Dn 2>/dev/null | awk '$3 ~ /^15b3:/ {print $1}' | tr '\n' ' ')
fi
if [ -z "$mlx_devs" ]; then
  echo "n/a no Mellanox/NVIDIA NIC"; exit 0
elif [ -z "$flint_bin" ]; then
  item WARN "flint/mstflint missing, cannot query: $mlx_devs"
else
  sec_ok=0; sec_bad=0; sec_unknown=0
  for dev in $mlx_devs; do
    q_out=$(timeout 30 "$flint_bin" -d "$dev" q 2>/dev/null)
    if [ -z "$q_out" ]; then item WARN "UNVERIFIED $(basename "$dev") flint query returned nothing (mst started? device access?)"; sec_unknown=$((sec_unknown + 1)); continue; fi
    sec_attr=$(echo "$q_out" | grep -i 'Security Attributes' | head -1 | sed 's/^[^:]*:[[:space:]]*//' | sed 's/[[:space:]]*$//')
    dname=$(basename "$dev")
    fw_ver=$(echo "$q_out" | awk -F: '/^FW Version/{gsub(/[[:space:]]/,"",$2); print $2; exit}')
    if [ -n "$fw_ver" ]; then
      fw_min=$(_mlx_fw_min "${fw_ver%%.*}")
      if [ -z "$fw_min" ]; then item INFO "$dname fw=$fw_ver (no threshold)"
      elif _ver_ge "$fw_ver" "$fw_min"; then item OK "$dname fw=$fw_ver min=$fw_min"
      else item FAIL "$dname fw=$fw_ver min=$fw_min"; fi
    fi
    if [ -z "$sec_attr" ]; then
      item WARN "$dname security=no Security Attributes"
      sec_unknown=$((sec_unknown + 1))
    elif echo "$sec_attr" | grep -qw 'secure-fw'; then
      if echo "$sec_attr" | grep -qwE 'dev|debug|debug-token'; then
        item FAIL "$dname security=$sec_attr"; sec_bad=$((sec_bad + 1))
      else
        item OK "$dname security=$sec_attr"; sec_ok=$((sec_ok + 1))
      fi
    elif echo "$sec_attr" | grep -qw 'signed-fw'; then
      item FAIL "$dname security=$sec_attr"; sec_bad=$((sec_bad + 1))
    else
      item FAIL "$dname security=$sec_attr"; sec_bad=$((sec_bad + 1))
    fi
  done
  item INFO "secure-fw ok=$sec_ok bad=$sec_bad unknown=$sec_unknown"
fi
out "no result"
  ]]></Execute>
  <Operator>regex</Operator>
  <ExpectedResult>^(OK|INFO|n/a)( |$)</ExpectedResult>
</Plugin>
<Plugin>
  <PluginName>31.3 - BlueField VIRTIO-Net controller and Snap4 versions</PluginName>
  <PluginDescription>Script item 31, sub-section 31.3. Source: gpu_baseline_check_2.sh:3232-3277 (main_30_33.sh:675-720). dpkg-query/rpm virtio-net-controller*: 23.x&gt;=23.10.23, 24.x&gt;=24.10.50, 25.x&gt;=25.10.2, below -&gt; FAIL, other major -&gt; INFO. Running images matching 'snap' (docker ps): 4.5&gt;=4.5.5, 4.9&gt;=4.9.1, below -&gt; FAIL, other -&gt; INFO. Nothing found -&gt; the script prints nothing -&gt; n/a. Verdict = worst result in this sub-section, FAIL &gt; WARN &gt; OK &gt; INFO. Gate (script lines 524-532 and detect_platform): systemd-detect-virt (else /sys/hypervisor/type, else unknown) not 'none'/'unknown' -&gt; 'n/a VM (&lt;type&gt;)' (script: PASS, skip item 31). Output: '&lt;OK|INFO|WARN|FAIL|n/a&gt; &lt;observed&gt;'. WARN fails in Bitscan. Changed 2026-11-18: a two-part Snap tag (for example 4.5) is normalised to x.y.0 before the branch is chosen, so its threshold applies; systemd-detect-virt --vm.</PluginDescription>
  <PluginId>93c922f6-292c-429b-b9fb-925587cffd9e</PluginId>
  <Execute timeout="60"><![CDATA[
_ver_num() { printf '%s\n' "${1:-}" | grep -oE '[0-9]+(\.[0-9]+)*' | head -1; }
_ver_ge() {
  _a=$(_ver_num "${1:-}"); _b=$(_ver_num "${2:-}")
  if [ -z "$_a" ] || [ -z "$_b" ]; then return 1; fi
  [ "$_a" = "$_b" ] && return 0
  [ "$(printf '%s\n%s\n' "$_a" "$_b" | sort -V | head -1)" = "$_b" ]
}
V=""; D=""
item() {
  case "$1" in
    FAIL) V=FAIL ;;
    WARN) [ "$V" = FAIL ] || V=WARN ;;
    OK) case "$V" in FAIL|WARN) ;; *) V=OK ;; esac ;;
    INFO) [ -n "$V" ] || V=INFO ;;
  esac
  [ -n "${2:-}" ] && D="${D:+$D; }$2"
  return 0
}
out() {
  if [ -z "$V" ]; then printf 'n/a %s\n' "$1" | tr -s ' '
  else printf '%s %s\n' "$V" "$(printf '%s' "$D" | tr '\n' ' ' | tr -s ' ')"; fi
}
if command -v systemd-detect-virt >/dev/null 2>&1; then
  VIRT_TYPE=$(systemd-detect-virt --vm 2>/dev/null) || VIRT_TYPE="none"
elif [ -r /sys/hypervisor/type ]; then
  VIRT_TYPE=$(cat /sys/hypervisor/type 2>/dev/null)
else
  VIRT_TYPE="unknown"
fi
[ -z "$VIRT_TYPE" ] && VIRT_TYPE="unknown"
if [ "$VIRT_TYPE" != "none" ] && [ "$VIRT_TYPE" != "unknown" ]; then echo "n/a VM ($VIRT_TYPE)"; exit 0; fi
vnc_ver=""; vnc_min=""
if command -v dpkg-query >/dev/null 2>&1; then
  vnc_ver=$(dpkg-query -W -f='${Version}\n' 'virtio-net-controller*' 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
elif command -v rpm >/dev/null 2>&1; then
  vnc_ver=$(rpm -qa 'virtio-net-controller*' --qf '%{VERSION}\n' 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
fi
if [ -n "$vnc_ver" ]; then
  case "${vnc_ver%%.*}" in
    23) vnc_min="23.10.23" ;;
    24) vnc_min="24.10.50" ;;
    25) vnc_min="25.10.2" ;;
  esac
  if [ -z "$vnc_min" ]; then item INFO "virtio-net-controller=$vnc_ver (no threshold)"
  elif _ver_ge "$vnc_ver" "$vnc_min"; then item OK "virtio-net-controller=$vnc_ver min=$vnc_min"
  else item FAIL "virtio-net-controller=$vnc_ver min=$vnc_min"; fi
fi
if command -v docker >/dev/null 2>&1; then
  snap_imgs=$(docker ps --format '{{.Image}}' 2>/dev/null | grep -i 'snap' | sort -u)
  while IFS= read -r snap_img; do
    [ -z "$snap_img" ] && continue
    snap_ver=$(echo "${snap_img##*:}" | grep -oE '^[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1)
    [ -z "$snap_ver" ] && continue
    if echo "$snap_ver" | grep -qE '^[0-9]+\.[0-9]+$'; then snap_ver="$snap_ver.0"; fi
    case "${snap_ver%.*}" in
      4.5) snap_min="4.5.5" ;;
      4.9) snap_min="4.9.1" ;;
      *)   snap_min="" ;;
    esac
    if [ -z "$snap_min" ]; then item INFO "snap4=$snap_img (no threshold)"
    elif _ver_ge "$snap_ver" "$snap_min"; then item OK "snap4=$snap_img min=$snap_min"
    else item FAIL "snap4=$snap_img min=$snap_min"; fi
  done <<SNAPEOF
$snap_imgs
SNAPEOF
fi
out "no virtio-net-controller package, no Snap4 container"
  ]]></Execute>
  <Operator>regex</Operator>
  <ExpectedResult>^(OK|INFO|n/a)( |$)</ExpectedResult>
</Plugin>
<Plugin>
  <PluginName>32.1 - umad/issm device exposure</PluginName>
  <PluginDescription>Script item 32, sub-section 32.1. Source: gpu_baseline_check_2.sh:3365-3415 (main_30_33.sh:808-858). Mode of /dev/infiniband/umad* and issm*: group or other digit not 0 -&gt; FAIL, else OK. umad present -&gt; FAIL in a container, WARN on a host; absent -&gt; OK. Same for issm. Verdict = worst result in this sub-section, FAIL &gt; WARN &gt; OK &gt; INFO. Gates (script lines 751-780): no /sys/class/infiniband entries -&gt; 'n/a no IB/RDMA device'; no port with link_layer=InfiniBand -&gt; 'n/a no native IB port' (script: PASS, skip item 32). in_container = /.dockerenv or docker|containerd|kubepods|lxc in /proc/1/cgroup; several lines are FAIL in a container and WARN/INFO on a host. Output: '&lt;OK|INFO|WARN|FAIL|n/a&gt; &lt;observed&gt;'. WARN fails in Bitscan. Changed 2026-11-18: umad/issm present on a host is INFO (expected on IB hosts with agent 0.5.4-1); ib_umad loaded but umad not visible gives WARN UNVERIFIED.</PluginDescription>
  <PluginId>45e92f17-714a-4e72-b4a4-3afd4413f019</PluginId>
  <Execute timeout="60"><![CDATA[
_ver_num() { printf '%s\n' "${1:-}" | grep -oE '[0-9]+(\.[0-9]+)*' | head -1; }
_ver_ge() {
  _a=$(_ver_num "${1:-}"); _b=$(_ver_num "${2:-}")
  if [ -z "$_a" ] || [ -z "$_b" ]; then return 1; fi
  [ "$_a" = "$_b" ] && return 0
  [ "$(printf '%s\n%s\n' "$_a" "$_b" | sort -V | head -1)" = "$_b" ]
}
V=""; D=""
item() {
  case "$1" in
    FAIL) V=FAIL ;;
    WARN) [ "$V" = FAIL ] || V=WARN ;;
    OK) case "$V" in FAIL|WARN) ;; *) V=OK ;; esac ;;
    INFO) [ -n "$V" ] || V=INFO ;;
  esac
  [ -n "${2:-}" ] && D="${D:+$D; }$2"
  return 0
}
out() {
  if [ -z "$V" ]; then printf 'n/a %s\n' "$1" | tr -s ' '
  else printf '%s %s\n' "$V" "$(printf '%s' "$D" | tr '\n' ' ' | tr -s ' ')"; fi
}
ib_devs=""
[ -d /sys/class/infiniband ] && ib_devs=$(ls /sys/class/infiniband 2>/dev/null | tr '\n' ' ')
if [ -z "$ib_devs" ]; then echo "n/a no IB/RDMA device"; exit 0; fi
has_ib_port=false
for _d in $ib_devs; do
  for _p in /sys/class/infiniband/"$_d"/ports/*; do
    [ -d "$_p" ] || continue
    [ "$(cat "$_p/link_layer" 2>/dev/null)" = "InfiniBand" ] && has_ib_port=true
  done
done
if ! $has_ib_port; then echo "n/a no native IB port (all RoCE, see 33)"; exit 0; fi
in_container=false
if [ -f /.dockerenv ] || grep -qE '(docker|containerd|kubepods|lxc)' /proc/1/cgroup 2>/dev/null; then in_container=true; fi
umad_devs=$(ls /dev/infiniband/umad* 2>/dev/null | tr '\n' ' ')
issm_devs=$(ls /dev/infiniband/issm* 2>/dev/null | tr '\n' ' ')
for ud in $umad_devs $issm_devs; do
  perm=$(stat -c '%a' "$ud" 2>/dev/null); owner=$(stat -c '%U:%G' "$ud" 2>/dev/null)
  l1=${perm#"${perm%?}"}; p2=${perm%?}; l2=${p2#"${p2%?}"}
  if [ -n "$perm" ] && { [ "$l1" != "0" ] || [ "$l2" != "0" ]; }; then
    item FAIL "$(basename "$ud") mode=$perm $owner (group/other can send MADs)"
  else
    item OK "$(basename "$ud") mode=$perm $owner"
  fi
done
if [ -n "$umad_devs" ]; then
  if $in_container; then item FAIL "umad visible in container: $umad_devs"
  else item INFO "umad present on host: $umad_devs"; fi
elif ls -d /sys/class/infiniband_mad/umad* >/dev/null 2>&1; then
  item WARN "UNVERIFIED ib_umad loaded but /dev/infiniband/umad* not visible to the runner (agent older than 0.5.4-1?)"
else
  item OK "umad=absent (ib_umad not loaded)"
fi
if [ -n "$issm_devs" ]; then
  if $in_container; then item FAIL "issm visible in container: $issm_devs"
  else item INFO "issm present on host: $issm_devs"; fi
else
  item OK "issm=absent"
fi
out "no result"
  ]]></Execute>
  <Operator>regex</Operator>
  <ExpectedResult>^(OK|INFO|n/a)( |$)</ExpectedResult>
</Plugin>
<Plugin>
  <PluginName>32.2 - SM identity, M_Key and switch-port partition enforcement</PluginName>
  <PluginDescription>Rewritten 2026-11-18 (needs agent 0.5.4-1 for MAD access). Per ACTIVE InfiniBand port, with -C/-P so each rail is queried: (1) sminfo: master SM GUID, priority and state; FAIL if UFM_SM_GUIDS is set and the GUID is not in it; WARN if priority below 15; FAIL if reachable from a container. (2) smpquery portinfo on this port: ProtectBits 2 or 3 OK, 0 or 1 FAIL (M_Key not enforced); MkeyLeasePeriod not 0 WARN. (3) Directed route 0,port to the switch port facing this HCA: PartEnfInb and PartEnfOutb both 1 OK, else FAIL; switch port pkey table with 0xffff FAIL. No fabric-wide discovery (ibhosts, ibswitches, saquery). Anything that cannot be read gives WARN UNVERIFIED. Read-only MAD Get queries. Output: &lt;OK|INFO|WARN|FAIL|n/a&gt; &lt;observed&gt;. WARN fails in Bitscan.</PluginDescription>
  <PluginId>cf6ddfbe-5002-489e-a233-946c53ca2809</PluginId>
  <Execute timeout="120"><![CDATA[
_ver_num() { printf '%s\n' "${1:-}" | grep -oE '[0-9]+(\.[0-9]+)*' | head -1; }
_ver_ge() {
  _a=$(_ver_num "${1:-}"); _b=$(_ver_num "${2:-}")
  if [ -z "$_a" ] || [ -z "$_b" ]; then return 1; fi
  [ "$_a" = "$_b" ] && return 0
  [ "$(printf '%s\n%s\n' "$_a" "$_b" | sort -V | head -1)" = "$_b" ]
}
V=""; D=""
item() {
  case "$1" in
    FAIL) V=FAIL ;;
    WARN) [ "$V" = FAIL ] || V=WARN ;;
    OK) case "$V" in FAIL|WARN) ;; *) V=OK ;; esac ;;
    INFO) [ -n "$V" ] || V=INFO ;;
  esac
  [ -n "${2:-}" ] && D="${D:+$D; }$2"
  return 0
}
out() {
  if [ -z "$V" ]; then printf 'n/a %s\n' "$1" | tr -s ' '
  else printf '%s %s\n' "$V" "$(printf '%s' "$D" | tr '\n' ' ' | tr -s ' ')"; fi
}
ib_devs=""
[ -d /sys/class/infiniband ] && ib_devs=$(ls /sys/class/infiniband 2>/dev/null | tr '\n' ' ')
if [ -z "$ib_devs" ]; then echo "n/a no IB/RDMA device"; exit 0; fi
has_ib_port=false
for _d in $ib_devs; do
  for _p in /sys/class/infiniband/"$_d"/ports/*; do
    [ -d "$_p" ] || continue
    [ "$(cat "$_p/link_layer" 2>/dev/null)" = "InfiniBand" ] && has_ib_port=true
  done
done
if ! $has_ib_port; then echo "n/a no native IB port (all RoCE, see 33)"; exit 0; fi
in_container=false
if [ -f /.dockerenv ] || grep -qE '(docker|containerd|kubepods|lxc)' /proc/1/cgroup 2>/dev/null; then in_container=true; fi
# Space-separated port GUIDs of the UFM Subnet Managers (primary and standby).
# Empty = report the SM only; set it to FAIL on any other master SM.
UFM_SM_GUIDS=""
if ! command -v sminfo >/dev/null 2>&1 || ! command -v smpquery >/dev/null 2>&1; then
  echo "WARN UNVERIFIED infiniband-diags (sminfo, smpquery) not installed"; exit 0
fi
if ! ls /dev/infiniband/umad* >/dev/null 2>&1; then
  if ls -d /sys/class/infiniband_mad/umad* >/dev/null 2>&1; then
    echo "WARN UNVERIFIED /dev/infiniband/umad* not visible to the runner (needs agent 0.5.4-1)"
  else
    echo "WARN UNVERIFIED ib_umad not loaded, no MAD access"
  fi
  exit 0
fi
for dev in $ib_devs; do
  for port in /sys/class/infiniband/"$dev"/ports/*; do
    [ "$(cat "$port/link_layer" 2>/dev/null)" = "InfiniBand" ] || continue
    pn=$(basename "$port")
    case "$(cat "$port/state" 2>/dev/null)" in *ACTIVE*) ;; *) item INFO "$dev:$pn not ACTIVE, skipped"; continue ;; esac
    lid=$(cat "$port/lid" 2>/dev/null)
    # SM identity
    so=$(timeout 10 sminfo -C "$dev" -P "$pn" 2>&1)
    g=$(echo "$so" | grep -oE 'sm guid 0x[0-9a-fA-F]+' | awk '{print $3}')
    pr=$(echo "$so" | grep -oE 'priority [0-9]+' | awk '{print $2}')
    st=$(echo "$so" | grep -oE 'SMINFO_[A-Z]+')
    if [ -z "$g" ]; then
      item WARN "$dev:$pn UNVERIFIED sminfo: $(echo "$so" | head -1)"
    else
      if $in_container; then item FAIL "$dev:$pn SM reachable from a container (sm=$g)"; fi
      if [ -z "$UFM_SM_GUIDS" ]; then item INFO "$dev:$pn sm=$g prio=${pr:-?} $st (UFM_SM_GUIDS not set)"
      else
        case " $UFM_SM_GUIDS " in *" $g "*) item OK "$dev:$pn sm=$g prio=${pr:-?} $st" ;; *) item FAIL "$dev:$pn master SM $g is not a UFM SM" ;; esac
      fi
      [ "${pr:-0}" -lt 15 ] && item WARN "$dev:$pn SM priority ${pr:-?} below 15"
    fi
    # M_Key protection on this host's port
    pi=$(timeout 10 smpquery -C "$dev" -P "$pn" portinfo "$lid" "$pn" 2>&1)
    pb=$(echo "$pi" | grep -i 'protectbits' | grep -oE '[0-9]+$' | head -1)
    ls_=$(echo "$pi" | grep -i 'mkeyleaseperiod' | grep -oE '[0-9]+$' | head -1)
    case "$pb" in
      2|3) item OK "$dev:$pn ProtectBits=$pb" ;;
      '')  item WARN "$dev:$pn UNVERIFIED ProtectBits unreadable: $(echo "$pi" | head -1)" ;;
      *)   item FAIL "$dev:$pn ProtectBits=$pb (M_Key not enforced)" ;;
    esac
    [ "${ls_:-0}" -ne 0 ] && item WARN "$dev:$pn MkeyLeasePeriod=$ls_ (protection lapses if the SM goes quiet)"
    # Switch port facing this HCA (one hop, directed route)
    sp=$(timeout 10 smpquery -C "$dev" -P "$pn" -D nodeinfo 0,"$pn" 2>/dev/null | grep -i 'localport' | grep -oE '[0-9]+$' | head -1)
    if [ -z "$sp" ]; then
      item WARN "$dev:$pn UNVERIFIED switch port not readable"
      continue
    fi
    sw=$(timeout 10 smpquery -C "$dev" -P "$pn" -D portinfo 0,"$pn" "$sp" 2>&1)
    ei=$(echo "$sw" | grep -i 'partenfinb' | grep -oE '[0-9]+$' | head -1)
    eo=$(echo "$sw" | grep -i 'partenfoutb' | grep -oE '[0-9]+$' | head -1)
    if [ "$ei" = 1 ] && [ "$eo" = 1 ]; then item OK "$dev:$pn switch port $sp PartEnf in/out=1/1"
    elif [ -z "$ei$eo" ]; then item WARN "$dev:$pn UNVERIFIED switch port $sp PartEnf unreadable"
    else item FAIL "$dev:$pn switch port $sp PartEnf in=${ei:-?} out=${eo:-?}"; fi
    spk=$(timeout 10 smpquery -C "$dev" -P "$pn" -D pkeys 0,"$pn" "$sp" 2>/dev/null | grep -oiE '0x[0-9a-f]{4}' | grep -viE '^0x0000$' | sort -u | tr '\n' ' ')
    if echo "$spk" | grep -qiE '0xffff'; then item FAIL "$dev:$pn switch port $sp is a full member of the default partition: $spk"
    elif [ -z "$spk" ]; then item WARN "$dev:$pn UNVERIFIED switch port $sp pkey table unreadable"
    else item INFO "$dev:$pn switch port $sp pkeys=$spk"; fi
  done
done
out "no active IB port"
  ]]></Execute>
  <Operator>regex</Operator>
  <ExpectedResult>^(OK|INFO|n/a)( |$)</ExpectedResult>
</Plugin>
<Plugin>
  <PluginName>32.3 - PKey partition isolation</PluginName>
  <PluginDescription>Rewritten 2026-11-18. Per ACTIVE InfiniBand port (DOWN ports are skipped, they show a default 0xffff): empty pkey table FAIL; 0xffff (full member of the default partition) FAIL; no dedicated full-member pkey WARN; full member of more than one dedicated partition WARN (verify against UFM); exactly one dedicated full-member pkey OK, printed so it can be reconciled with UFM. Membership is bit 15 of the pkey. Output: &lt;OK|INFO|WARN|FAIL|n/a&gt; &lt;observed&gt;. WARN fails in Bitscan.</PluginDescription>
  <PluginId>0dafaed7-36ec-4e0c-9524-f7ff47293022</PluginId>
  <Execute timeout="60"><![CDATA[
_ver_num() { printf '%s\n' "${1:-}" | grep -oE '[0-9]+(\.[0-9]+)*' | head -1; }
_ver_ge() {
  _a=$(_ver_num "${1:-}"); _b=$(_ver_num "${2:-}")
  if [ -z "$_a" ] || [ -z "$_b" ]; then return 1; fi
  [ "$_a" = "$_b" ] && return 0
  [ "$(printf '%s\n%s\n' "$_a" "$_b" | sort -V | head -1)" = "$_b" ]
}
V=""; D=""
item() {
  case "$1" in
    FAIL) V=FAIL ;;
    WARN) [ "$V" = FAIL ] || V=WARN ;;
    OK) case "$V" in FAIL|WARN) ;; *) V=OK ;; esac ;;
    INFO) [ -n "$V" ] || V=INFO ;;
  esac
  [ -n "${2:-}" ] && D="${D:+$D; }$2"
  return 0
}
out() {
  if [ -z "$V" ]; then printf 'n/a %s\n' "$1" | tr -s ' '
  else printf '%s %s\n' "$V" "$(printf '%s' "$D" | tr '\n' ' ' | tr -s ' ')"; fi
}
ib_devs=""
[ -d /sys/class/infiniband ] && ib_devs=$(ls /sys/class/infiniband 2>/dev/null | tr '\n' ' ')
if [ -z "$ib_devs" ]; then echo "n/a no IB/RDMA device"; exit 0; fi
has_ib_port=false
for _d in $ib_devs; do
  for _p in /sys/class/infiniband/"$_d"/ports/*; do
    [ -d "$_p" ] || continue
    [ "$(cat "$_p/link_layer" 2>/dev/null)" = "InfiniBand" ] && has_ib_port=true
  done
done
if ! $has_ib_port; then echo "n/a no native IB port (all RoCE, see 33)"; exit 0; fi
in_container=false
if [ -f /.dockerenv ] || grep -qE '(docker|containerd|kubepods|lxc)' /proc/1/cgroup 2>/dev/null; then in_container=true; fi
for dev in $ib_devs; do
  for port in /sys/class/infiniband/"$dev"/ports/*; do
    [ "$(cat "$port/link_layer" 2>/dev/null)" = "InfiniBand" ] || continue
    pn=$(basename "$port"); st=$(cat "$port/state" 2>/dev/null)
    case "$st" in *ACTIVE*) ;; *) item INFO "$dev:$pn state=${st:-?} skipped"; continue ;; esac
    pk=$(cat "$port"/pkeys/* 2>/dev/null | grep -viE '^0x0000$' | sort -u | tr '\n' ' ')
    if [ -z "$pk" ]; then item FAIL "$dev:$pn empty pkey table"; continue; fi
    fdef=0; ldef=0; dfull=""; dlim=""
    for k in $pk; do
      case "$k" in
        0xffff|0xFFFF) fdef=1 ;;
        0x7fff|0x7FFF) ldef=1 ;;
        *) if [ $(( k & 0x8000 )) -ne 0 ]; then dfull="$dfull$k "; else dlim="$dlim$k "; fi ;;
      esac
    done
    nf=$(echo $dfull | wc -w)
    if [ "$fdef" -eq 1 ]; then item FAIL "$dev:$pn 0xffff full member of the default partition pkeys=$pk"
    elif [ "$nf" -eq 0 ]; then item WARN "$dev:$pn no dedicated full-member pkey pkeys=$pk"
    elif [ "$nf" -gt 1 ]; then item WARN "$dev:$pn full member of $nf partitions (${dfull% }), verify against UFM"
    else item OK "$dev:$pn tenant_pkey=${dfull% } limited=${dlim:-none} default=$([ "$ldef" = 1 ] && echo 0x7fff || echo none)"; fi
  done
done
out "no active IB port"
  ]]></Execute>
  <Operator>regex</Operator>
  <ExpectedResult>^(OK|INFO|n/a)( |$)</ExpectedResult>
</Plugin>
<Plugin>
  <PluginName>32.4 - opensm on this node</PluginName>
  <PluginDescription>Rewritten 2026-11-18. opensm running on a GPU host FAIL (only UFM should run a Subnet Manager). For each readable opensm.conf: m_key unset or 0 FAIL; m_key_protection_level not 2 or 3 FAIL; sm_key unset or 0 FAIL; part_enforce off/in/out FAIL; no_partition_enforcement TRUE FAIL; partitions file missing or empty FAIL; sm_priority INFO. Not running OK; binary installed INFO. Output: &lt;OK|INFO|WARN|FAIL|n/a&gt; &lt;observed&gt;. WARN fails in Bitscan.</PluginDescription>
  <PluginId>020bd0d5-a61e-4420-927b-e8954297b844</PluginId>
  <Execute timeout="60"><![CDATA[
