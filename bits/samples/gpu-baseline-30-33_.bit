  0) item OK "ib_core netns_mode=0 (exclusive)" ;;
  1) if $ctr_rt; then item FAIL "ib_core netns_mode=1 (shared) with a container runtime"; else item INFO "ib_core netns_mode=1 (shared, no container runtime)"; fi ;;
  *)
