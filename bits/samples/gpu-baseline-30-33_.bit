mgmt_devs=$(ls /dev/infiniband/umad* /dev/infiniband/issm* 2>/dev/null | tr '\n' ' ')
if [ -n "$mgmt_devs" ]; then
  if $in_container; then item FAIL "umad/issm visible in container: $mgmt_devs"
  else item INFO "umad/issm present on host: $mgmt_devs"; fi
else
  item OK "umad/issm=absent"
fi
uverbs_devs=$(ls /dev/infiniband/uverbs* 2>/dev/null | tr '\n' ' ')
if [ -n "$uverbs_devs" ]; then
  item INFO "uverbs=$uverbs_devs"
  if $in_container && ! $sriov_found; then item WARN "container RDMA device looks like a shared PF (no SR-IOV)"; fi
fi
end_sec 33.4 "no result"
