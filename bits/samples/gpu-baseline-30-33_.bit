  [ "$(printf '%s\n%s\n' "$_a" "$_b" | sort -V | head -1)" = "$_b" ]
}
V=""; D=""
item() {
  case "$1" in
    FAIL) V=FAIL ;;
    WARN) [ "$V" = FAIL ] || V=WARN ;;
    OK) case "$V" in FAIL|WARN) ;; *) V=OK ;; esac ;;
    INFO) [ -n "$V" ] || V=INFO ;;
  esac
  [ -n "${2:-}" ] && D="${D:+$D; }$2"
  return 0
}
out() {
  if [ -z "$V" ]; then printf 'n/a %s\n' "$1" | tr -s ' '
  else printf '%s %s\n' "$V" "$(printf '%s' "$D" | tr '\n' ' ' | tr -s ' ')"; fi
}
ib_devs=""
[ -d /sys/class/infiniband ] && ib_devs=$(ls /sys/class/infiniband 2>/dev/null | tr '\n' ' ')
if [ -z "$ib_devs" ]; then echo "n/a no IB/RDMA device"; exit 0; fi
has_ib_port=false
for _d in $ib_devs; do
  for _p in /sys/class/infiniband/"$_d"/ports/*; do
    [ -d "$_p" ] || continue
    [ "$(cat "$_p/link_layer" 2>/dev/null)" = "InfiniBand" ] && has_ib_port=true
  done
done
if ! $has_ib_port; then echo "n/a no native IB port (all RoCE, see 33)"; exit 0; fi
in_container=false
if [ -f /.dockerenv ] || grep -qE '(docker|containerd|kubepods|lxc)' /proc/1/cgroup 2>/dev/null; then in_container=true; fi
ib_ifaces=$(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | grep -E '^ib[0-9]' | tr '\n' ' ')
for ifc in $ib_ifaces; do
  neigh_count=$(ip neigh show dev "$ifc" 2>/dev/null | grep -c .)
  if [ "${neigh_count:-0}" -gt 1 ]; then item INFO "$ifc neighbours=$neigh_count"
  else item OK "$ifc neighbours=${neigh_count:-0}"; fi
done
out "no IPoIB interface"
  ]]></Execute>
  <Operator>regex</Operator>
  <ExpectedResult>^(OK|INFO|n/a)( |$)</ExpectedResult>
</Plugin>
<Plugin>
  <PluginName>32.7 - GPUDirect RDMA with PKey isolation</PluginName>
  <PluginDescription>Script item 32, sub-section 32.7. Source: gpu_baseline_check_2.sh:3637-3646 (main_30_33.sh:1080-1089). nvidia_peermem loaded -&gt; INFO; and if any IB port is a 0xffff full member (32.3 logic) -&gt; FAIL. Not loaded -&gt; n/a. Verdict = worst result in this sub-section, FAIL &gt; WARN &gt; OK &gt; INFO. Gates (script lines 751-780): no /sys/class/infiniband entries -&gt; 'n/a no IB/RDMA device'; no port with link_layer=InfiniBand -&gt; 'n/a no native IB port' (script: PASS, skip item 32). in_container = /.dockerenv or docker|containerd|kubepods|lxc in /proc/1/cgroup; several lines are FAIL in a container and WARN/INFO on a host. Output: '&lt;OK|INFO|WARN|FAIL|n/a&gt; &lt;observed&gt;'. WARN fails in Bitscan. Changed 2026-11-18: DOWN ports are skipped, as in 32.3.</PluginDescription>
  <PluginId>1b261a76-df76-42a3-878d-0fd05a497487</PluginId>
  <Execute timeout="60"><![CDATA[
_ver_num() { printf '%s\n' "${1:-}" | grep -oE '[0-9]+(\.[0-9]+)*' | head -1; }
_ver_ge() {
  _a=$(_ver_num "${1:-}"); _b=$(_ver_num "${2:-}")
  if [ -z "$_a" ] || [ -z "$_b" ]; then return 1; fi
  [ "$_a" = "$_b" ] && return 0
  [ "$(printf '%s\n%s\n' "$_a" "$_b" | sort -V | head -1)" = "$_b" ]
}
V=""; D=""
item() {
  case "$1" in
    FAIL) V=FAIL ;;
    WARN) [ "$V" = FAIL ] || V=WARN ;;
    OK) case "$V" in FAIL|WARN) ;; *) V=OK ;; esac ;;
    INFO) [ -n "$V" ] || V=INFO ;;
  esac
  [ -n "${2:-}" ] && D="${D:+$D; }$2"
  return 0
}
out() {
  if [ -z "$V" ]; then printf 'n/a %s\n' "$1" | tr -s ' '
  else printf '%s %s\n' "$V" "$(printf '%s' "$D" | tr '\n' ' ' | tr -s ' ')"; fi
}
ib_devs=""
[ -d /sys/class/infiniband ] && ib_devs=$(ls /sys/class/infiniband 2>/dev/null | tr '\n' ' ')
if [ -z "$ib_devs" ]; then echo "n/a no IB/RDMA device"; exit 0; fi
has_ib_port=false
for _d in $ib_devs; do
  for _p in /sys/class/infiniband/"$_d"/ports/*; do
    [ -d "$_p" ] || continue
    [ "$(cat "$_p/link_layer" 2>/dev/null)" = "InfiniBand" ] && has_ib_port=true
  done
done
if ! $has_ib_port; then echo "n/a no native IB port (all RoCE, see 33)"; exit 0; fi
in_container=false
if [ -f /.dockerenv ] || grep -qE '(docker|containerd|kubepods|lxc)' /proc/1/cgroup 2>/dev/null; then in_container=true; fi
pkey_issue=false
for dev in $ib_devs; do
  for port in /sys/class/infiniband/"$dev"/ports/*; do
    [ -d "$port/pkeys" ] || continue
    pnum=$(basename "$port")
    lt=$(cat "$port/link_layer" 2>/dev/null || echo "?")
    [ "$lt" = "Ethernet" ] && continue
    case "$(cat "$port/state" 2>/dev/null)" in *ACTIVE*) ;; *) continue ;; esac
    pkeys=$(cat "$port"/pkeys/* 2>/dev/null | grep -viE '^0x0000$' | sort -u | tr '\n' ' ')
    full_default=$(echo "$pkeys" | grep -ciE '0xffff')
    limited_default=$(echo "$pkeys" | grep -ciE '0x7fff')
    extra=$(echo "$pkeys" | tr ' ' '\n' | grep -viE '^(0xffff|0x7fff)$' | grep -c .)
    if [ "${full_default:-0}" -gt 0 ]; then
      item FAIL "$dev:$pnum 0xffff full member pkeys=${pkeys:-empty}"
      pkey_issue=true
    elif [ "${limited_default:-0}" -gt 0 ] && [ "${extra:-0}" -eq 0 ]; then
      item WARN "$dev:$pnum only 0x7fff limited member pkeys=${pkeys:-empty}"
    else
      item OK "$dev:$pnum dedicated=$extra pkeys=${pkeys:-empty}"
    fi
  done
done
V=""; D=""
if lsmod 2>/dev/null | awk '{print $1}' | grep -qx nvidia_peermem; then
  item INFO "nvidia_peermem=loaded"
  if $pkey_issue; then item FAIL "GPUDirect RDMA with 0xffff full-member PKey (no tenant isolation)"; fi
fi
out "nvidia_peermem not loaded"
  ]]></Execute>
  <Operator>regex</Operator>
  <ExpectedResult>^(OK|INFO|n/a)( |$)</ExpectedResult>
</Plugin>
<Plugin>
  <PluginName>32.8 - InfiniBand SR-IOV exposure</PluginName>
  <PluginDescription>Added 2026-11-18. Per InfiniBand device: sriov_totalvfs 0 OK; SR-IOV enabled in firmware but no VFs WARN (root on the host can create VFs); VFs present WARN, with each VF policy and node GUID as INFO (VF GUID and P_Key must be set by the provider, not the tenant). Where /dev/mst exists, mlxconfig SRIOV_EN and NUM_OF_VFS as INFO. Read-only. Output: &lt;OK|INFO|WARN|FAIL|n/a&gt; &lt;observed&gt;. WARN fails in Bitscan.</PluginDescription>
  <PluginId>cc8d9426-411e-4858-a95d-38c9e1d495b4</PluginId>
  <Execute timeout="60"><![CDATA[
_ver_num() { printf '%s\n' "${1:-}" | grep -oE '[0-9]+(\.[0-9]+)*' | head -1; }
_ver_ge() {
  _a=$(_ver_num "${1:-}"); _b=$(_ver_num "${2:-}")
  if [ -z "$_a" ] || [ -z "$_b" ]; then return 1; fi
  [ "$_a" = "$_b" ] && return 0
  [ "$(printf '%s\n%s\n' "$_a" "$_b" | sort -V | head -1)" = "$_b" ]
}
V=""; D=""
item() {
  case "$1" in
    FAIL) V=FAIL ;;
    WARN) [ "$V" = FAIL ] || V=WARN ;;
    OK) case "$V" in FAIL|WARN) ;; *) V=OK ;; esac ;;
    INFO) [ -n "$V" ] || V=INFO ;;
  esac
  [ -n "${2:-}" ] && D="${D:+$D; }$2"
  return 0
}
out() {
  if [ -z "$V" ]; then printf 'n/a %s\n' "$1" | tr -s ' '
  else printf '%s %s\n' "$V" "$(printf '%s' "$D" | tr '\n' ' ' | tr -s ' ')"; fi
}
ib_devs=""
[ -d /sys/class/infiniband ] && ib_devs=$(ls /sys/class/infiniband 2>/dev/null | tr '\n' ' ')
if [ -z "$ib_devs" ]; then echo "n/a no IB/RDMA device"; exit 0; fi
has_ib_port=false
for _d in $ib_devs; do
  for _p in /sys/class/infiniband/"$_d"/ports/*; do
    [ -d "$_p" ] || continue
    [ "$(cat "$_p/link_layer" 2>/dev/null)" = "InfiniBand" ] && has_ib_port=true
  done
done
if ! $has_ib_port; then echo "n/a no native IB port (all RoCE, see 33)"; exit 0; fi
in_container=false
if [ -f /.dockerenv ] || grep -qE '(docker|containerd|kubepods|lxc)' /proc/1/cgroup 2>/dev/null; then in_container=true; fi
found=false
for dev in $ib_devs; do
  ib=false
  for p in /sys/class/infiniband/"$dev"/ports/*; do [ "$(cat "$p/link_layer" 2>/dev/null)" = "InfiniBand" ] && ib=true; done
  $ib || continue
  found=true
  tot=$(cat /sys/class/infiniband/"$dev"/device/sriov_totalvfs 2>/dev/null)
  num=$(cat /sys/class/infiniband/"$dev"/device/sriov_numvfs 2>/dev/null)
  case "${tot:-0}" in 0|'') item OK "$dev sriov=disabled"; continue ;; esac
  if [ "${num:-0}" -gt 0 ]; then
    item WARN "$dev sriov_totalvfs=$tot numvfs=$num (VF GUID and P_Key must be set by the provider)"
    for v in /sys/class/infiniband/"$dev"/device/sriov/*; do
      [ -d "$v" ] || continue
      item INFO "$dev vf$(basename "$v") policy=$(cat "$v/policy" 2>/dev/null) node=$(cat "$v/node" 2>/dev/null)"
    done
  else
    item WARN "$dev sriov_totalvfs=$tot (SR-IOV enabled in firmware; root on the host can create VFs)"
  fi
done
for m in /dev/mst/*_pciconf*; do
  [ -e "$m" ] || continue
  c=$(timeout 30 mlxconfig -d "$m" q 2>/dev/null | grep -E 'SRIOV_EN|NUM_OF_VFS' | tr -s ' ' | tr '\n' ';')
  [ -n "$c" ] && item INFO "$(basename "$m") $c"
done
$found || item INFO "no InfiniBand device"
out "no IB device"
  ]]></Execute>
  <Operator>regex</Operator>
  <ExpectedResult>^(OK|INFO|n/a)( |$)</ExpectedResult>
</Plugin>
<Plugin>
  <PluginName>33.1 - RoCE GID types</PluginName>
  <PluginDescription>Script item 33, sub-section 33.1. Source: gpu_baseline_check_2.sh:3730-3767 (main_30_33.sh:1173-1210). Per RoCE port: count non-empty GIDs by gid_attrs/types (RoCE v2, IB/RoCE v1, unknown) -&gt; INFO; any unknown type -&gt; WARN. Verdict = worst result in this sub-section, FAIL &gt; WARN &gt; OK &gt; INFO. Gate (script lines 1136-1158): no RDMA port with link_layer=Ethernet -&gt; 'n/a no RoCE port' (script: PASS, skip item 33). in_container = /.dockerenv or docker|containerd|kubepods|lxc in /proc/1/cgroup. Output: '&lt;OK|INFO|WARN|FAIL|n/a&gt; &lt;observed&gt;'. WARN fails in Bitscan. Changed 2026-11-18: 33.2 RoCE v1 GIDs without SR-IOV are INFO (kernel default); 33.3 shared netns is FAIL only with a container runtime; 33.4 umad/issm on a host is INFO.</PluginDescription>
  <PluginId>f9a41f63-942b-42c4-b15b-dba89ae642b9</PluginId>
  <Execute timeout="60"><![CDATA[
_ver_num() { printf '%s\n' "${1:-}" | grep -oE '[0-9]+(\.[0-9]+)*' | head -1; }
_ver_ge() {
  _a=$(_ver_num "${1:-}"); _b=$(_ver_num "${2:-}")
  if [ -z "$_a" ] || [ -z "$_b" ]; then return 1; fi
  [ "$_a" = "$_b" ] && return 0
  [ "$(printf '%s\n%s\n' "$_a" "$_b" | sort -V | head -1)" = "$_b" ]
}
V=""; D=""
item() {
  case "$1" in
    FAIL) V=FAIL ;;
    WARN) [ "$V" = FAIL ] || V=WARN ;;
    OK) case "$V" in FAIL|WARN) ;; *) V=OK ;; esac ;;
    INFO) [ -n "$V" ] || V=INFO ;;
  esac
  [ -n "${2:-}" ] && D="${D:+$D; }$2"
  return 0
}
out() {
  if [ -z "$V" ]; then printf 'n/a %s\n' "$1" | tr -s ' '
  else printf '%s %s\n' "$V" "$(printf '%s' "$D" | tr '\n' ' ' | tr -s ' ')"; fi
}
SEC=33.1
roce_ports=""
if [ -d /sys/class/infiniband ]; then
  for dev_path in /sys/class/infiniband/*; do
    [ -d "$dev_path" ] || continue
    dname=$(basename "$dev_path")
    for port_path in "$dev_path"/ports/*; do
      [ -d "$port_path" ] || continue
      pnum=$(basename "$port_path")
      lt=$(cat "$port_path/link_layer" 2>/dev/null)
      [ "$lt" = "Ethernet" ] && roce_ports="$roce_ports$dname:$pnum "
    done
  done
fi
if [ -z "$roce_ports" ]; then echo "n/a no RoCE port"; exit 0; fi
in_container=false
if [ -f /.dockerenv ] || grep -qE '(docker|containerd|kubepods|lxc)' /proc/1/cgroup 2>/dev/null; then in_container=true; fi
ISSUES=0
end_sec() {
  [ "$V" = "FAIL" ] && ISSUES=1
  if [ "$SEC" = "$1" ]; then out "$2"; exit 0; fi
  V=""; D=""
}
# 33.1 RoCE version and GID table
v1_total=0; v2_total=0; vunknown_total=0; roce_netdevs=""
for rp in $roce_ports; do
  dname="${rp%%:*}"; pnum="${rp##*:}"
  port_path="/sys/class/infiniband/$dname/ports/$pnum"
  [ -d "$port_path/gids" ] || continue
  v1=0; v2=0; vunk=0
  for gid_entry in "$port_path"/gids/*; do
    [ -r "$gid_entry" ] || continue
    gid_val=$(cat "$gid_entry" 2>/dev/null)
    [ "$gid_val" = "0000:0000:0000:0000:0000:0000:0000:0000" ] && continue
    [ "$gid_val" = "fe80:0000:0000:0000:0000:0000:0000:0000" ] && continue
    idx_name=$(basename "$gid_entry")
    gid_type=$(cat "$port_path/gid_attrs/types/$idx_name" 2>/dev/null)
    gid_ndev=$(cat "$port_path/gid_attrs/ndevs/$idx_name" 2>/dev/null)
    if [ -n "$gid_ndev" ]; then
      case " $roce_netdevs " in *" $gid_ndev "*) ;; *) roce_netdevs="$roce_netdevs$gid_ndev " ;; esac
    fi
    case "$gid_type" in
      "RoCE v2")    v2=$((v2 + 1)) ;;
      "IB/RoCE v1") v1=$((v1 + 1)) ;;
      *)            vunk=$((vunk + 1)) ;;
    esac
  done
  v1_total=$((v1_total + v1)); v2_total=$((v2_total + v2)); vunknown_total=$((vunknown_total + vunk))
  item INFO "$rp gids v2=$v2 v1=$v1 unknown=$vunk"
done
[ -n "$roce_netdevs" ] && item INFO "netdevs=$roce_netdevs"
[ "$vunknown_total" -gt 0 ] && item WARN "unrecognised gid types=$vunknown_total"
end_sec 33.1 "no GID table on RoCE ports $roce_ports"
# 33.2 SR-IOV VF anti-spoofing, PF VLAN, RoCE v1
pf_list=""
for rp in $roce_ports; do
  dname="${rp%%:*}"
  for nd in /sys/class/infiniband/"$dname"/device/net/*; do
    [ -d "$nd" ] || continue
    ndn=$(basename "$nd")
    case " $pf_list " in *" $ndn "*) ;; *) pf_list="$pf_list$ndn " ;; esac
  done
done
[ -z "$pf_list" ] && pf_list="$roce_netdevs"
[ -z "$pf_list" ] && item WARN "PF lookup failed, VF checks not verified"
sriov_found=false; vf_total=0; vf_bad_spoof=0; vf_trusted=0; vf_no_vlan=0
for pf in $pf_list; do
  [ -n "$pf" ] || continue
  numvfs=0
  [ -r "/sys/class/net/$pf/device/sriov_numvfs" ] && numvfs=$(cat "/sys/class/net/$pf/device/sriov_numvfs" 2>/dev/null || echo 0)
  case "$numvfs" in ''|*[!0-9]*) numvfs=0 ;; esac
  if [ "$numvfs" -eq 0 ]; then item INFO "$pf numvfs=0"; continue; fi
  sriov_found=true
  item INFO "$pf numvfs=$numvfs"
  vf_lines=$(ip link show dev "$pf" 2>/dev/null | grep -E '^[[:space:]]*vf[[:space:]]+[0-9]+')
  if [ -z "$vf_lines" ]; then item WARN "$pf vf attributes unreadable"; continue; fi
  while IFS= read -r vf_line; do
    [ -n "$vf_line" ] || continue
    vf_id=$(echo "$vf_line" | grep -oE '^[[:space:]]*vf[[:space:]]+[0-9]+' | grep -oE '[0-9]+')
    vf_total=$((vf_total + 1))
    spoof="unknown"
    echo "$vf_line" | grep -q 'spoof checking on' && spoof="on"
    echo "$vf_line" | grep -q 'spoof checking off' && spoof="off"
    trust="unknown"
    echo "$vf_line" | grep -q 'trust on' && trust="on"
    echo "$vf_line" | grep -q 'trust off' && trust="off"
    vlan_id=$(echo "$vf_line" | grep -oE ', vlan [0-9]+' | grep -oE '[0-9]+' | head -1)
    [ -z "$vlan_id" ] && vlan_id=0
    vf_status="OK"
    if [ "$spoof" = "off" ]; then vf_status="FAIL"; vf_bad_spoof=$((vf_bad_spoof + 1))
    elif [ "$spoof" = "unknown" ]; then vf_status="WARN"; fi
    if [ "$trust" = "on" ]; then vf_status="FAIL"; vf_trusted=$((vf_trusted + 1))
    elif [ "$trust" = "unknown" ]; then [ "$vf_status" = "OK" ] && vf_status="WARN"; fi
    if [ "$vlan_id" -eq 0 ] || [ "$vlan_id" -eq 4095 ]; then
      [ "$vf_status" = "OK" ] && vf_status="WARN"
      vf_no_vlan=$((vf_no_vlan + 1))
    fi
    if [ "$vf_status" = "OK" ]; then item OK ""
