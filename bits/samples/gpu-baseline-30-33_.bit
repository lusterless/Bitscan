done
[ -z "$pf_list" ] && pf_list="$roce_netdevs"
[ -z "$pf_list" ] && item WARN "PF lookup failed, VF checks not verified"
sriov_found=false; vf_total=0; vf_bad_spoof=0; vf_trusted=0; vf_no_vlan=0
for pf in $pf_list; do
  [ -n "$pf" ] || continue
  numvfs=0
  [ -r "/sys/class/net/$pf/device/sriov_numvfs" ] && numvfs=$(cat "/sys/class/net/$pf/device/sriov_numvfs" 2>/dev/null || echo 0)
  case "$numvfs" in ''|*[!0-9]*) numvfs=0 ;; esac
  if [ "$numvfs" -eq 0 ]; then item INFO "$pf numvfs=0"; continue; fi
  sriov_found=true
  item INFO "$pf numvfs=$numvfs"
  vf_lines=$(ip link show dev "$pf" 2>/dev/null | grep -E '^[[:space:]]*vf[[:space:]]+[0-9]+')
  if [ -z "$vf_lines" ]; then item WARN "$pf vf attributes unreadable"; continue; fi
  while IFS= read -r vf_line; do
    [ -n "$vf_line" ] || continue
    vf_id=$(echo "$vf_line" | grep -oE '^[[:space:]]*vf[[:space:]]+[0-9]+' | grep -oE '[0-9]+')
    vf_total=$((vf_total + 1))
    spoof="unknown"
    echo "$vf_line" | grep -q 'spoof checking on' && spoof="on"
    echo "$vf_line" | grep -q 'spoof checking off' && spoof="off"
    trust="unknown"
    echo "$vf_line" | grep -q 'trust on' && trust="on"
    echo "$vf_line" | grep -q 'trust off' && trust="off"
    vlan_id=$(echo "$vf_line" | grep -oE ', vlan [0-9]+' | grep -oE '[0-9]+' | head -1)
    [ -z "$vlan_id" ] && vlan_id=0
    vf_status="OK"
    if [ "$spoof" = "off" ]; then vf_status="FAIL"; vf_bad_spoof=$((vf_bad_spoof + 1))
    elif [ "$spoof" = "unknown" ]; then vf_status="WARN"; fi
    if [ "$trust" = "on" ]; then vf_status="FAIL"; vf_trusted=$((vf_trusted + 1))
    elif [ "$trust" = "unknown" ]; then [ "$vf_status" = "OK" ] && vf_status="WARN"; fi
    if [ "$vlan_id" -eq 0 ] || [ "$vlan_id" -eq 4095 ]; then
      [ "$vf_status" = "OK" ] && vf_status="WARN"
      vf_no_vlan=$((vf_no_vlan + 1))
    fi
    if [ "$vf_status" = "OK" ]; then item OK ""
    else item "$vf_status" "$pf vf$vf_id spoofchk=$spoof trust=$trust vlan=$vlan_id"; fi
  done <<VFEOF
$vf_lines
VFEOF
done
$sriov_found && item INFO "vfs=$vf_total spoofchk_off=$vf_bad_spoof trust_on=$vf_trusted no_pf_vlan=$vf_no_vlan"
$sriov_found || item INFO "sriov=no VF on any PF"
if [ "$v1_total" -gt 0 ]; then
  if $sriov_found && [ "$vf_no_vlan" -gt 0 ]; then item FAIL "roce v1 gids=$v1_total with VFs lacking a PF VLAN"
  elif $sriov_found; then item WARN "roce v1 gids=$v1_total"
  else item INFO "roce v1 gids=$v1_total (kernel default; isolation relies on the switch VLAN)"; fi
else
  item OK "roce v1 gids=0 v2=$v2_total"
fi
end_sec 33.2 "no result"
# 33.3 RDMA netns isolation
ctr_rt=false
for s in /run/containerd/containerd.sock /run/docker.sock /var/run/docker.sock; do [ -S "$s" ] && ctr_rt=true; done
$in_container && ctr_rt=true
netns_mode=""
[ -r /sys/module/ib_core/parameters/netns_mode ] && netns_mode=$(cat /sys/module/ib_core/parameters/netns_mode 2>/dev/null)
case "$netns_mode" in
  0) item OK "ib_core netns_mode=0 (exclusive)" ;;
  1) if $ctr_rt; then item FAIL "ib_core netns_mode=1 (shared) with a container runtime"; else item INFO "ib_core netns_mode=1 (shared, no container runtime)"; fi ;;
  *)
    if command -v rdma >/dev/null 2>&1; then
      rdma_sys=$(rdma system show 2>/dev/null)
      if echo "$rdma_sys" | grep -qw exclusive; then item OK "rdma netns=exclusive"
      elif echo "$rdma_sys" | grep -qw shared; then if $ctr_rt; then item FAIL "rdma netns=shared with a container runtime"; else item INFO "rdma netns=shared (no container runtime)"; fi
      else item WARN "rdma netns=unconfirmed"; fi
    else
      item WARN "rdma netns=unconfirmed (no ib_core param, no rdma tool)"
    fi ;;
esac
if [ "$netns_mode" = "0" ]; then
  if grep -rqsE '^[[:space:]]*options[[:space:]]+ib_core.*netns_mode=0' /etc/modprobe.d/ 2>/dev/null; then item OK "netns_mode persisted in modprobe.d"
  else item WARN "netns_mode not persisted in modprobe.d"; fi
fi
if command -v rdma >/dev/null 2>&1; then
  qkey_line=$(rdma system show 2>/dev/null | grep -oE 'privileged-qkey[[:space:]]+(on|off)')
  if [ -n "$qkey_line" ]; then
    if echo "$qkey_line" | grep -qw on; then item WARN "privileged-qkey=on"
    else item OK "privileged-qkey=off"; fi
  fi
fi
end_sec 33.3 "no result"
# 33.4 RDMA device nodes
mgmt_devs=$(ls /dev/infiniband/umad* /dev/infiniband/issm* 2>/dev/null | tr '\n' ' ')
if [ -n "$mgmt_devs" ]; then
  if $in_container; then item FAIL "umad/issm visible in container: $mgmt_devs"
  else item INFO "umad/issm present on host: $mgmt_devs"; fi
else
  item OK "umad/issm=absent"
fi
uverbs_devs=$(ls /dev/infiniband/uverbs* 2>/dev/null | tr '\n' ' ')
if [ -n "$uverbs_devs" ]; then
  item INFO "uverbs=$uverbs_devs"
  if $in_container && ! $sriov_found; then item WARN "container RDMA device looks like a shared PF (no SR-IOV)"; fi
fi
end_sec 33.4 "no result"
# 33.5 GPUDirect over RoCE
if lsmod 2>/dev/null | awk '{print $1}' | grep -qx nvidia_peermem; then
  item INFO "nvidia_peermem=loaded"
  [ "$ISSUES" = "1" ] && item FAIL "GPUDirect RDMA with RoCE isolation defects in 33.1-33.4"
fi
end_sec 33.5 "nvidia_peermem not loaded"
  ]]></Execute>
  <Operator>regex</Operator>
  <ExpectedResult>^(OK|INFO|n/a)( |$)</ExpectedResult>
</Plugin>
  </PluginsGroups>
</Policy>
