has_ib_port=false
for _d in $ib_devs; do
  for _p in /sys/class/infiniband/"$_d"/ports/*; do
    [ -d "$_p" ] || continue
    [ "$(cat "$_p/link_layer" 2>/dev/null)" = "InfiniBand" ] && has_ib_port=true
  done
done
if ! $has_ib_port; then echo "n/a no native IB port (all RoCE, see 33)"; exit 0; fi
in_container=false
if [ -f /.dockerenv ] || grep -qE '(docker|containerd|kubepods|lxc)' /proc/1/cgroup 2>/dev/null; then in_container=true; fi
if systemctl is-active --quiet opensm 2>/dev/null || pgrep -x opensm >/dev/null 2>&1; then
  item FAIL "opensm=running on this node (only UFM should run a Subnet Manager)"
  for osm_conf in /etc/opensm/opensm.conf /etc/rdma/opensm.conf; do
    [ -r "$osm_conf" ] || continue
    kv() { grep -E "^[[:space:]]*$1[[:space:]]" "$osm_conf" 2>/dev/null | awk '{print $2}' | tail -1; }
    m_key=$(kv m_key); osm_sm_key=$(kv sm_key); mkpl=$(kv m_key_protection_level)
    prio=$(kv sm_priority); penf=$(kv part_enforce); nope=$(kv no_partition_enforcement)
    if [ -z "$m_key" ] || echo "$m_key" | grep -qE '^0x0+$'; then item FAIL "$osm_conf m_key=${m_key:-unset}"; else item OK "$osm_conf m_key=set"; fi
    case "$mkpl" in 2|3) item OK "$osm_conf m_key_protection_level=$mkpl" ;; *) item FAIL "$osm_conf m_key_protection_level=${mkpl:-unset}" ;; esac
    if [ -z "$osm_sm_key" ] || echo "$osm_sm_key" | grep -qE '^0x0+$'; then item FAIL "$osm_conf sm_key=${osm_sm_key:-unset}"; else item OK "$osm_conf sm_key=set"; fi
    item INFO "$osm_conf sm_priority=${prio:-unset}"
    case "$penf" in off|in|out) item FAIL "$osm_conf part_enforce=$penf" ;; *) item INFO "$osm_conf part_enforce=${penf:-default}" ;; esac
    case "$nope" in TRUE|true) item FAIL "$osm_conf no_partition_enforcement=TRUE" ;; esac
    part_file=$(kv partition_config_file); part_file="${part_file:-/etc/opensm/partitions.conf}"
    if [ -r "$part_file" ] && grep -qvE '^\s*(#|$)' "$part_file" 2>/dev/null; then item OK "partitions=$part_file"
    else item FAIL "partitions=$part_file missing/empty"; fi
  done
else
  item OK "opensm=not running"
  if command -v opensm >/dev/null 2>&1; then item INFO "opensm binary installed (not running)"; fi
fi
out "no result"
  ]]></Execute>
  <Operator>regex</Operator>
  <ExpectedResult>^(OK|INFO|n/a)( |$)</ExpectedResult>
</Plugin>
<Plugin>
  <PluginName>32.5 - RDMA netns mode (rdma system show)</PluginName>
  <PluginDescription>Script item 32, sub-section 32.5. Source: gpu_baseline_check_2.sh:3591-3616 (main_30_33.sh:1034-1059). rdma system show netns: exclusive -&gt; OK, shared -&gt; FAIL, other/unreadable -&gt; WARN. rdma tool missing -&gt; WARN. Verdict = worst result in this sub-section, FAIL &gt; WARN &gt; OK &gt; INFO. Gates (script lines 751-780): no /sys/class/infiniband entries -&gt; 'n/a no IB/RDMA device'; no port with link_layer=InfiniBand -&gt; 'n/a no native IB port' (script: PASS, skip item 32). in_container = /.dockerenv or docker|containerd|kubepods|lxc in /proc/1/cgroup; several lines are FAIL in a container and WARN/INFO on a host. Output: '&lt;OK|INFO|WARN|FAIL|n/a&gt; &lt;observed&gt;'. WARN fails in Bitscan. Changed 2026-11-18: shared RDMA netns is FAIL only when a container runtime (docker, containerd) or a container is present; on bare metal without containers it is INFO.</PluginDescription>
  <PluginId>a31aa44d-9701-4ea5-82fb-ba9e5acbcb61</PluginId>
  <Execute timeout="60"><![CDATA[
_ver_num() { printf '%s\n' "${1:-}" | grep -oE '[0-9]+(\.[0-9]+)*' | head -1; }
_ver_ge() {
  _a=$(_ver_num "${1:-}"); _b=$(_ver_num "${2:-}")
  if [ -z "$_a" ] || [ -z "$_b" ]; then return 1; fi
  [ "$_a" = "$_b" ] && return 0
  [ "$(printf '%s\n%s\n' "$_a" "$_b" | sort -V | head -1)" = "$_b" ]
}
V=""; D=""
item() {
  case "$1" in
    FAIL) V=FAIL ;;
    WARN) [ "$V" = FAIL ] || V=WARN ;;
    OK) case "$V" in FAIL|WARN) ;; *) V=OK ;; esac ;;
    INFO) [ -n "$V" ] || V=INFO ;;
  esac
  [ -n "${2:-}" ] && D="${D:+$D; }$2"
  return 0
}
out() {
  if [ -z "$V" ]; then printf 'n/a %s\n' "$1" | tr -s ' '
  else printf '%s %s\n' "$V" "$(printf '%s' "$D" | tr '\n' ' ' | tr -s ' ')"; fi
}
ib_devs=""
[ -d /sys/class/infiniband ] && ib_devs=$(ls /sys/class/infiniband 2>/dev/null | tr '\n' ' ')
if [ -z "$ib_devs" ]; then echo "n/a no IB/RDMA device"; exit 0; fi
has_ib_port=false
for _d in $ib_devs; do
  for _p in /sys/class/infiniband/"$_d"/ports/*; do
    [ -d "$_p" ] || continue
    [ "$(cat "$_p/link_layer" 2>/dev/null)" = "InfiniBand" ] && has_ib_port=true
  done
done
if ! $has_ib_port; then echo "n/a no native IB port (all RoCE, see 33)"; exit 0; fi
in_container=false
if [ -f /.dockerenv ] || grep -qE '(docker|containerd|kubepods|lxc)' /proc/1/cgroup 2>/dev/null; then in_container=true; fi
ctr_rt=false
for s in /run/containerd/containerd.sock /run/docker.sock /var/run/docker.sock; do [ -S "$s" ] && ctr_rt=true; done
$in_container && ctr_rt=true
if command -v rdma >/dev/null 2>&1; then
  netns_mode=$(rdma system show 2>/dev/null | grep -oE 'netns [a-z]+' | awk '{print $2}')
  case "$netns_mode" in
    exclusive) item OK "rdma netns=exclusive" ;;
    shared)    if $ctr_rt; then item FAIL "rdma netns=shared with a container runtime"; else item INFO "rdma netns=shared (no container runtime)"; fi ;;
    *)         item WARN "rdma netns=${netns_mode:-unavailable}" ;;
  esac
else
  item WARN "rdma tool=not installed"
fi
out "no result"
  ]]></Execute>
  <Operator>regex</Operator>
  <ExpectedResult>^(OK|INFO|n/a)( |$)</ExpectedResult>
</Plugin>
<Plugin>
  <PluginName>32.6 - IPoIB neighbour count</PluginName>
  <PluginDescription>Script item 32, sub-section 32.6. Source: gpu_baseline_check_2.sh:3618-3635 (main_30_33.sh:1061-1078). Per ib[0-9]* interface: ip neigh show dev &lt;if&gt; lines &gt;1 -&gt; WARN, else OK. No IPoIB interface -&gt; n/a. Verdict = worst result in this sub-section, FAIL &gt; WARN &gt; OK &gt; INFO. Gates (script lines 751-780): no /sys/class/infiniband entries -&gt; 'n/a no IB/RDMA device'; no port with link_layer=InfiniBand -&gt; 'n/a no native IB port' (script: PASS, skip item 32). in_container = /.dockerenv or docker|containerd|kubepods|lxc in /proc/1/cgroup; several lines are FAIL in a container and WARN/INFO on a host. Output: '&lt;OK|INFO|WARN|FAIL|n/a&gt; &lt;observed&gt;'. WARN fails in Bitscan. Changed 2026-11-18: neighbour count is INFO; several IPoIB neighbours are normal inside one tenant cluster.</PluginDescription>
  <PluginId>4c940105-c263-4758-9bc3-3b3243277f9a</PluginId>
  <Execute timeout="60"><![CDATA[
_ver_num() { printf '%s\n' "${1:-}" | grep -oE '[0-9]+(\.[0-9]+)*' | head -1; }
_ver_ge() {
  _a=$(_ver_num "${1:-}"); _b=$(_ver_num "${2:-}")
  if [ -z "$_a" ] || [ -z "$_b" ]; then return 1; fi
