  if [ "$numvfs" -eq 0 ]; then item INFO "$pf numvfs=0"; continue; fi
  sriov_found=true
  item INFO "$pf numvfs=$numvfs"
  vf_lines=$(ip link show dev "$pf" 2>/dev/null | grep -E '^[[:space:]]*vf[[:space:]]+[0-9]+')
  if [ -z "$vf_lines" ]; then item WARN "$pf vf attributes unreadable"; continue; fi
  while IFS= read -r vf_line; do
    [ -n "$vf_line" ] || continue
    vf_id=$(echo "$vf_line" | grep -oE '^[[:space:]]*vf[[:space:]]+[0-9]+' | grep -oE '[0-9]+')
    vf_total=$((vf_total + 1))
    spoof="unknown"
    echo "$vf_line" | grep -q 'spoof checking on' && spoof="on"
    echo "$vf_line" | grep -q 'spoof checking off' && spoof="off"
    trust="unknown"
    echo "$vf_line" | grep -q 'trust on' && trust="on"
    echo "$vf_line" | grep -q 'trust off' && trust="off"
    vlan_id=$(echo "$vf_line" | grep -oE ', vlan [0-9]+' | grep -oE '[0-9]+' | head -1)
    [ -z "$vlan_id" ] && vlan_id=0
    vf_status="OK"
    if [ "$spoof" = "off" ]; then vf_status="FAIL"; vf_bad_spoof=$((vf_bad_spoof + 1))
    elif [ "$spoof" = "unknown" ]; then vf_status="WARN"; fi
    if [ "$trust" = "on" ]; then vf_status="FAIL"; vf_trusted=$((vf_trusted + 1))
    elif [ "$trust" = "unknown" ]; then [ "$vf_status" = "OK" ] && vf_status="WARN"; fi
