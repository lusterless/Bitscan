if lsmod 2>/dev/null | awk '{print $1}' | grep -qx nvidia_peermem; then
  item INFO "nvidia_peermem=loaded"
  [ "$ISSUES" = "1" ] && item FAIL "GPUDirect RDMA with RoCE isolation defects in 33.1-33.4"
fi
end_sec 33.5 "nvidia_peermem not loaded"
