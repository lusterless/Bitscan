_ver_num() { printf '%s\n' "${1:-}" | grep -oE '[0-9]+(\.[0-9]+)*' | head -1; }
_ver_ge() {
  _a=$(_ver_num "${1:-}"); _b=$(_ver_num "${2:-}")
  if [ -z "$_a" ] || [ -z "$_b" ]; then return 1; fi
  [ "$_a" = "$_b" ] && return 0
  [ "$(printf '%s\n%s\n' "$_a" "$_b" | sort -V | head -1)" = "$_b" ]
}
V=""; D=""
item() {
  case "$1" in
    FAIL) V=FAIL ;;
    WARN) [ "$V" = FAIL ] || V=WARN ;;
    OK) case "$V" in FAIL|WARN) ;; *) V=OK ;; esac ;;
    INFO) [ -n "$V" ] || V=INFO ;;
  esac
  [ -n "${2:-}" ] && D="${D:+$D; }$2"
  return 0
}
out() {
  if [ -z "$V" ]; then printf 'n/a %s\n' "$1" | tr -s ' '
  else printf '%s %s\n' "$V" "$(printf '%s' "$D" | tr '\n' ' ' | tr -s ' ')"; fi
}
has_gpu=false
if [ -d /proc/driver/nvidia ] || command -v nvidia-smi >/dev/null 2>&1; then has_gpu=true; fi
if ! $has_gpu; then
  for f in /dev/nvidia[0-9]*; do if [ -e "$f" ]; then has_gpu=true; break; fi; done
fi
if ! $has_gpu && lspci 2>/dev/null | grep -qi 'NVIDIA.*\(3D controller\|VGA compatible\)'; then has_gpu=true; fi
if ! $has_gpu; then echo "n/a no NVIDIA GPU"; exit 0; fi
runc_ver=""; runc_rc=""
if command -v runc >/dev/null 2>&1; then
  runc_ver=$(runc --version 2>/dev/null | awk '/^runc version/{print $3; exit}' | grep -oE '^[0-9]+(\.[0-9]+)*')
  runc_rc=$(runc --version 2>/dev/null | awk '/^runc version/{print $3; exit}' | grep -oE -e '-rc\.?[0-9]+' | grep -oE '[0-9]+$')
fi
if [ -n "$runc_ver" ]; then
  runc_branch=$(echo "$runc_ver" | cut -d. -f1-2)
  case "$runc_branch" in
    1.5) runc_min="1.5.0" ;;
    1.4) runc_min="1.4.3" ;;
    1.3) runc_min="1.3.6" ;;
    1.2) runc_min="1.2.8" ;;
    1.1) runc_min="1.1.14" ;;
    1.0) runc_min="1.0.3" ;;
    0.1) runc_min="0.1.0" ;;
    *)   runc_min="1.3.6" ;;
  esac
  runc_rc_bad=false
  if [ "$runc_branch" = "1.5" ] && [ "$runc_ver" = "1.5.0" ] && [ -n "$runc_rc" ] && [ "$runc_rc" -lt 3 ]; then runc_rc_bad=true; fi
  rcs=""; [ -n "$runc_rc" ] && rcs="-rc.$runc_rc"
  if _ver_ge "$runc_ver" "$runc_min" && ! $runc_rc_bad; then
    item OK "runc=$runc_ver$rcs min=$runc_min"
  else
    if $runc_rc_bad; then item FAIL "runc=$runc_ver$rcs min=1.5.0-rc.3"
    else item FAIL "runc=$runc_ver$rcs min=$runc_min"; fi
  fi
else
  item INFO "runc=not installed"
fi
out "no result"
  ]]></Execute>
