<?xml version="1.0" encoding="UTF-8"?>
<Policy formatVersion="1.0">
  <PolicyName>GPU Baseline items 30-33</PolicyName>
  <PolicyDescription>Check GPU component versions and multi-tenant settings, firmware: Secure Boot, Secure Host, InfiniBand isolation and RoCE isolation</PolicyDescription>
  <PolicyStatus>enabled</PolicyStatus>
  <Family>
    <FamilyName>GPU Baseline</FamilyName>
  </Family>
  <PluginsGroups>
<Plugin>
  <PluginName>30.1 - NVIDIA Driver version</PluginName>
  <PluginDescription>Script item 30, sub-section 30.1. Source: gpu_baseline_check_2.sh:2599-2666 (main_30_33.sh:42-109). GPU model/count (INFO). Driver version from /sys/module/nvidia/version, nvidia-smi, /proc/driver/nvidia/version. Minimum per branch: R615&gt;=615.71.09, R610&gt;=610.57.04, R595&gt;=595.91.07, R590&gt;=590.48.01, R580&gt;=580.178.04, R570&gt;=570.211.01, R535&gt;=535.309.01 (EOL note -&gt; WARN even when OK); branch &lt;535 -&gt; min 535.309.01; other branches -&gt; WARN (no threshold). Below min -&gt; FAIL. Version unreadable -&gt; WARN. vGPU (lsmod nvidia_vgpu_vfio|vfio_mdev or /sys/class/mdev_bus) -&gt; WARN. Versions compared with the script's _ver_ge (sort -V, fail-closed). Verdict = worst result in this sub-section, FAIL &gt; WARN &gt; OK &gt; INFO; the WARN/FAIL lines the script adds to item 30's issues/warns are included. Gate (script lines 28-40): no /proc/driver/nvidia, no nvidia-smi, no /dev/nvidia[0-9]*, no NVIDIA 3D/VGA in lspci -&gt; 'n/a no NVIDIA GPU' (script: PASS, skip item 30). Output: '&lt;OK|INFO|WARN|FAIL|n/a&gt; &lt;observed&gt;'. WARN fails in Bitscan. Changed 2026-11-18: nvidia-smi present but silent gives WARN UNVERIFIED instead of passing.</PluginDescription>
  <PluginId>3f8252fb-7c69-4b41-ab96-5ce7e332267f</PluginId>
  <Execute timeout="60"><![CDATA[
_ver_num() { printf '%s\n' "${1:-}" | grep -oE '[0-9]+(\.[0-9]+)*' | head -1; }
_ver_ge() {
  _a=$(_ver_num "${1:-}"); _b=$(_ver_num "${2:-}")
  if [ -z "$_a" ] || [ -z "$_b" ]; then return 1; fi
  [ "$_a" = "$_b" ] && return 0
  [ "$(printf '%s\n%s\n' "$_a" "$_b" | sort -V | head -1)" = "$_b" ]
}
V=""; D=""
item() {
  case "$1" in
    FAIL) V=FAIL ;;
    WARN) [ "$V" = FAIL ] || V=WARN ;;
    OK) case "$V" in FAIL|WARN) ;; *) V=OK ;; esac ;;
    INFO) [ -n "$V" ] || V=INFO ;;
  esac
  [ -n "${2:-}" ] && D="${D:+$D; }$2"
  return 0
}
out() {
  if [ -z "$V" ]; then printf 'n/a %s\n' "$1" | tr -s ' '
  else printf '%s %s\n' "$V" "$(printf '%s' "$D" | tr '\n' ' ' | tr -s ' ')"; fi
}
has_gpu=false
if [ -d /proc/driver/nvidia ] || command -v nvidia-smi >/dev/null 2>&1; then has_gpu=true; fi
if ! $has_gpu; then
  for f in /dev/nvidia[0-9]*; do if [ -e "$f" ]; then has_gpu=true; break; fi; done
fi
if ! $has_gpu && lspci 2>/dev/null | grep -qi 'NVIDIA.*\(3D controller\|VGA compatible\)'; then has_gpu=true; fi
if ! $has_gpu; then echo "n/a no NVIDIA GPU"; exit 0; fi
gpu_count=$(nvidia-smi --list-gpus 2>/dev/null | grep -c .)
gpu_model=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)
item INFO "gpu=${gpu_model:-unknown} x ${gpu_count:-?}"
if [ -z "$gpu_model" ] && command -v nvidia-smi >/dev/null 2>&1; then item WARN "UNVERIFIED nvidia-smi returned no GPU (device access?)"; fi
drv_ver=""
[ -r /sys/module/nvidia/version ] && drv_ver=$(cat /sys/module/nvidia/version 2>/dev/null)
[ -z "$drv_ver" ] && drv_ver=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1)
if [ -z "$drv_ver" ] && [ -r /proc/driver/nvidia/version ]; then
  drv_ver=$(grep -oE 'Kernel Module +[0-9.]+' /proc/driver/nvidia/version 2>/dev/null | grep -oE '[0-9.]+')
fi
drv_ver=$(_ver_num "$drv_ver")
if [ -z "$drv_ver" ]; then
  item WARN "driver=unavailable"
else
  drv_branch=$(echo "$drv_ver" | cut -d. -f1); drv_min=""; drv_note=""
  case "$drv_branch" in
    615) drv_min="615.71.09" ;;
    610) drv_min="610.57.04" ;;
    595) drv_min="595.91.07" ;;
    590) drv_min="590.48.01" ;;
    580) drv_min="580.178.04" ;;
    570) drv_min="570.211.01" ;;
    535) drv_min="535.309.01"; drv_note="R535 EOL, migrate to R580" ;;
    *)
      case "$drv_branch" in
        ''|*[!0-9]*) drv_note="unknown branch R$drv_branch, no threshold" ;;
        *) if [ "$drv_branch" -lt 535 ]; then drv_min="535.309.01"; drv_note="branch below R535, no security support"
           else drv_note="unknown branch R$drv_branch, no threshold"; fi ;;
      esac ;;
  esac
  if [ -n "$drv_min" ]; then
    if _ver_ge "$drv_ver" "$drv_min"; then
      item OK "driver=$drv_ver R$drv_branch min=$drv_min"
      [ -n "$drv_note" ] && item WARN "$drv_note"
    else
      item FAIL "driver=$drv_ver R$drv_branch min=$drv_min"
    fi
  else
    item WARN "driver=$drv_ver R$drv_branch ${drv_note:-no threshold}"
  fi
  if lsmod 2>/dev/null | grep -qE '^(nvidia_vgpu_vfio|vfio_mdev)' || [ -d /sys/class/mdev_bus ]; then
    item WARN "vGPU manager=enabled (check CVE-2026-24200 fix)"
  fi
fi
out "no result"
  ]]></Execute>
  <Operator>regex</Operator>
  <ExpectedResult>^(OK|INFO|n/a)( |$)</ExpectedResult>
</Plugin>
<Plugin>
  <PluginName>30.2 - CUDA Toolkit version</PluginName>
  <PluginDescription>Script item 30, sub-section 30.2. Source: gpu_baseline_check_2.sh:2668-2700 (main_30_33.sh:111-143). CUDA Toolkit from nvcc --version, /usr/local/cuda*/version.json, /usr/local/cuda-* dir names. Not found -&gt; INFO. &gt;= 13.4.92 -&gt; OK, below -&gt; WARN. Verdict = worst result in this sub-section, FAIL &gt; WARN &gt; OK &gt; INFO; the WARN/FAIL lines the script adds to item 30's issues/warns are included. Gate (script lines 28-40): no /proc/driver/nvidia, no nvidia-smi, no /dev/nvidia[0-9]*, no NVIDIA 3D/VGA in lspci -&gt; 'n/a no NVIDIA GPU' (script: PASS, skip item 30). Output: '&lt;OK|INFO|WARN|FAIL|n/a&gt; &lt;observed&gt;'. WARN fails in Bitscan.</PluginDescription>
  <PluginId>4537f29b-450a-418c-80f3-056c58bc0657</PluginId>
  <Execute timeout="60"><![CDATA[
_ver_num() { printf '%s\n' "${1:-}" | grep -oE '[0-9]+(\.[0-9]+)*' | head -1; }
_ver_ge() {
  _a=$(_ver_num "${1:-}"); _b=$(_ver_num "${2:-}")
  if [ -z "$_a" ] || [ -z "$_b" ]; then return 1; fi
  [ "$_a" = "$_b" ] && return 0
  [ "$(printf '%s\n%s\n' "$_a" "$_b" | sort -V | head -1)" = "$_b" ]
}
V=""; D=""
item() {
  case "$1" in
    FAIL) V=FAIL ;;
    WARN) [ "$V" = FAIL ] || V=WARN ;;
    OK) case "$V" in FAIL|WARN) ;; *) V=OK ;; esac ;;
    INFO) [ -n "$V" ] || V=INFO ;;
  esac
  [ -n "${2:-}" ] && D="${D:+$D; }$2"
  return 0
}
out() {
  if [ -z "$V" ]; then printf 'n/a %s\n' "$1" | tr -s ' '
  else printf '%s %s\n' "$V" "$(printf '%s' "$D" | tr '\n' ' ' | tr -s ' ')"; fi
}
has_gpu=false
if [ -d /proc/driver/nvidia ] || command -v nvidia-smi >/dev/null 2>&1; then has_gpu=true; fi
if ! $has_gpu; then
  for f in /dev/nvidia[0-9]*; do if [ -e "$f" ]; then has_gpu=true; break; fi; done
fi
if ! $has_gpu && lspci 2>/dev/null | grep -qi 'NVIDIA.*\(3D controller\|VGA compatible\)'; then has_gpu=true; fi
if ! $has_gpu; then echo "n/a no NVIDIA GPU"; exit 0; fi
cuda_ver=""
if command -v nvcc >/dev/null 2>&1; then
  cuda_ver=$(nvcc --version 2>/dev/null | grep -oE 'V[0-9]+\.[0-9]+\.[0-9]+' | head -1 | tr -d 'V')
  [ -z "$cuda_ver" ] && cuda_ver=$(nvcc --version 2>/dev/null | grep -oE 'release [0-9]+\.[0-9]+' | grep -oE '[0-9.]+')
fi
if [ -z "$cuda_ver" ]; then
  for vj in /usr/local/cuda/version.json /usr/local/cuda-*/version.json; do
    [ -r "$vj" ] || continue
    cuda_ver=$(grep -A3 '"cuda"' "$vj" 2>/dev/null | grep -oE '"version" *: *"[0-9.]+"' | grep -oE '[0-9.]+' | head -1)
    [ -n "$cuda_ver" ] && break
  done
fi
[ -z "$cuda_ver" ] && cuda_ver=$(ls -d /usr/local/cuda-* 2>/dev/null | grep -oE '[0-9]+\.[0-9]+$' | sort -V | tail -1)
CUDA_MIN="13.4.92"
if [ -z "$cuda_ver" ]; then
  item INFO "cuda=not installed min=$CUDA_MIN"
elif _ver_ge "$cuda_ver" "$CUDA_MIN"; then
  item OK "cuda=$cuda_ver min=$CUDA_MIN"
else
  item WARN "cuda=$cuda_ver min=$CUDA_MIN"
fi
out "no result"
  ]]></Execute>
  <Operator>regex</Operator>
  <ExpectedResult>^(OK|INFO|n/a)( |$)</ExpectedResult>
</Plugin>
<Plugin>
  <PluginName>30.3 - cuDNN version</PluginName>
  <PluginDescription>Script item 30, sub-section 30.3. Source: gpu_baseline_check_2.sh:2702-2726 (main_30_33.sh:145-169). cuDNN version from cudnn_version.h or libcudnn.so.*. No CVE threshold: always INFO (found or not). Verdict = worst result in this sub-section, FAIL &gt; WARN &gt; OK &gt; INFO; the WARN/FAIL lines the script adds to item 30's issues/warns are included. Gate (script lines 28-40): no /proc/driver/nvidia, no nvidia-smi, no /dev/nvidia[0-9]*, no NVIDIA 3D/VGA in lspci -&gt; 'n/a no NVIDIA GPU' (script: PASS, skip item 30). Output: '&lt;OK|INFO|WARN|FAIL|n/a&gt; &lt;observed&gt;'. WARN fails in Bitscan.</PluginDescription>
  <PluginId>fec965fc-1385-4115-a344-40ceabb80295</PluginId>
  <Execute timeout="60"><![CDATA[
_ver_num() { printf '%s\n' "${1:-}" | grep -oE '[0-9]+(\.[0-9]+)*' | head -1; }
_ver_ge() {
  _a=$(_ver_num "${1:-}"); _b=$(_ver_num "${2:-}")
  if [ -z "$_a" ] || [ -z "$_b" ]; then return 1; fi
  [ "$_a" = "$_b" ] && return 0
  [ "$(printf '%s\n%s\n' "$_a" "$_b" | sort -V | head -1)" = "$_b" ]
}
V=""; D=""
item() {
  case "$1" in
    FAIL) V=FAIL ;;
    WARN) [ "$V" = FAIL ] || V=WARN ;;
    OK) case "$V" in FAIL|WARN) ;; *) V=OK ;; esac ;;
    INFO) [ -n "$V" ] || V=INFO ;;
  esac
  [ -n "${2:-}" ] && D="${D:+$D; }$2"
  return 0
}
out() {
  if [ -z "$V" ]; then printf 'n/a %s\n' "$1" | tr -s ' '
  else printf '%s %s\n' "$V" "$(printf '%s' "$D" | tr '\n' ' ' | tr -s ' ')"; fi
}
has_gpu=false
if [ -d /proc/driver/nvidia ] || command -v nvidia-smi >/dev/null 2>&1; then has_gpu=true; fi
if ! $has_gpu; then
  for f in /dev/nvidia[0-9]*; do if [ -e "$f" ]; then has_gpu=true; break; fi; done
fi
if ! $has_gpu && lspci 2>/dev/null | grep -qi 'NVIDIA.*\(3D controller\|VGA compatible\)'; then has_gpu=true; fi
if ! $has_gpu; then echo "n/a no NVIDIA GPU"; exit 0; fi
cudnn_ver=""
for h in /usr/include/cudnn_version.h /usr/include/*/cudnn_version.h \
         /usr/local/cuda/include/cudnn_version.h /usr/local/cuda-*/include/cudnn_version.h; do
  [ -r "$h" ] || continue
  M=$(awk '/#define CUDNN_MAJOR/{print $3; exit}' "$h" 2>/dev/null)
  m=$(awk '/#define CUDNN_MINOR/{print $3; exit}' "$h" 2>/dev/null)
  p=$(awk '/#define CUDNN_PATCHLEVEL/{print $3; exit}' "$h" 2>/dev/null)
  case "$M" in ''|*[!0-9]*) ;; *) cudnn_ver="$M.${m:-0}.${p:-0}"; break ;; esac
done
if [ -z "$cudnn_ver" ]; then
  cudnn_ver=$(ls /usr/lib/x86_64-linux-gnu/libcudnn.so.* /usr/lib64/libcudnn.so.* 2>/dev/null \
    | grep -oE 'so\.[0-9]+(\.[0-9]+)*' | grep -oE '[0-9]+(\.[0-9]+)*' | sort -V | tail -1)
fi
if [ -z "$cudnn_ver" ]; then item INFO "cudnn=not installed"
else item INFO "cudnn=$cudnn_ver (no CVE threshold)"; fi
out "no result"
  ]]></Execute>
  <Operator>regex</Operator>
  <ExpectedResult>^(OK|INFO|n/a)( |$)</ExpectedResult>
</Plugin>
<Plugin>
  <PluginName>30.4 - NCCL version and SGLang exposure</PluginName>
  <PluginDescription>Script item 30, sub-section 30.4. Source: gpu_baseline_check_2.sh:2728-2759 (main_30_33.sh:171-202). NCCL version from nccl.h or libnccl.so.*: INFO, no threshold. When NCCL is found and a sglang process runs (pgrep -af) -&gt; WARN (CVE-2026-15978). Verdict = worst result in this sub-section, FAIL &gt; WARN &gt; OK &gt; INFO; the WARN/FAIL lines the script adds to item 30's issues/warns are included. Gate (script lines 28-40): no /proc/driver/nvidia, no nvidia-smi, no /dev/nvidia[0-9]*, no NVIDIA 3D/VGA in lspci -&gt; 'n/a no NVIDIA GPU' (script: PASS, skip item 30). Output: '&lt;OK|INFO|WARN|FAIL|n/a&gt; &lt;observed&gt;'. WARN fails in Bitscan. Changed 2026-11-18: also finds NCCL installed as a pip wheel (nvidia-nccl-cu*) in system Python paths.</PluginDescription>
  <PluginId>06968cc5-00dc-4af0-b642-3c8b7f2ad8f9</PluginId>
  <Execute timeout="60"><![CDATA[
_ver_num() { printf '%s\n' "${1:-}" | grep -oE '[0-9]+(\.[0-9]+)*' | head -1; }
_ver_ge() {
  _a=$(_ver_num "${1:-}"); _b=$(_ver_num "${2:-}")
  if [ -z "$_a" ] || [ -z "$_b" ]; then return 1; fi
  [ "$_a" = "$_b" ] && return 0
  [ "$(printf '%s\n%s\n' "$_a" "$_b" | sort -V | head -1)" = "$_b" ]
}
V=""; D=""
item() {
  case "$1" in
    FAIL) V=FAIL ;;
    WARN) [ "$V" = FAIL ] || V=WARN ;;
    OK) case "$V" in FAIL|WARN) ;; *) V=OK ;; esac ;;
    INFO) [ -n "$V" ] || V=INFO ;;
  esac
  [ -n "${2:-}" ] && D="${D:+$D; }$2"
  return 0
}
out() {
  if [ -z "$V" ]; then printf 'n/a %s\n' "$1" | tr -s ' '
  else printf '%s %s\n' "$V" "$(printf '%s' "$D" | tr '\n' ' ' | tr -s ' ')"; fi
}
has_gpu=false
if [ -d /proc/driver/nvidia ] || command -v nvidia-smi >/dev/null 2>&1; then has_gpu=true; fi
if ! $has_gpu; then
  for f in /dev/nvidia[0-9]*; do if [ -e "$f" ]; then has_gpu=true; break; fi; done
fi
if ! $has_gpu && lspci 2>/dev/null | grep -qi 'NVIDIA.*\(3D controller\|VGA compatible\)'; then has_gpu=true; fi
if ! $has_gpu; then echo "n/a no NVIDIA GPU"; exit 0; fi
nccl_ver=""
for h in /usr/include/nccl.h /usr/include/*/nccl.h \
         /usr/local/cuda/include/nccl.h /usr/local/cuda-*/include/nccl.h; do
  [ -r "$h" ] || continue
  NM=$(awk '/#define NCCL_MAJOR/{print $3; exit}' "$h" 2>/dev/null)
  Nm=$(awk '/#define NCCL_MINOR/{print $3; exit}' "$h" 2>/dev/null)
  Np=$(awk '/#define NCCL_PATCH/{print $3; exit}' "$h" 2>/dev/null)
  case "$NM" in ''|*[!0-9]*) ;; *) nccl_ver="$NM.${Nm:-0}.${Np:-0}"; break ;; esac
done
if [ -z "$nccl_ver" ]; then
  nccl_ver=$(ls /usr/lib/x86_64-linux-gnu/libnccl.so.* /usr/lib64/libnccl.so.* 2>/dev/null \
    | grep -oE 'so\.[0-9]+(\.[0-9]+)*' | grep -oE '[0-9]+(\.[0-9]+)*' | sort -V | tail -1)
fi
if [ -z "$nccl_ver" ]; then
  nccl_ver=$(ls -d /usr/local/lib/python3*/dist-packages/nvidia_nccl_cu*-*.dist-info /usr/lib/python3*/*-packages/nvidia_nccl_cu*-*.dist-info /usr/local/lib/python3*/site-packages/nvidia_nccl_cu*-*.dist-info 2>/dev/null \
    | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | sort -V | tail -1)
fi
if [ -z "$nccl_ver" ]; then
  item INFO "nccl=not installed"
else
  item INFO "nccl=$nccl_ver (no CVE threshold)"
  if pgrep -af '[s]glang' >/dev/null 2>&1; then
    item WARN "sglang process running (check CVE-2026-15978 API key)"
  fi
fi
out "no result"
  ]]></Execute>
  <Operator>regex</Operator>
  <ExpectedResult>^(OK|INFO|n/a)( |$)</ExpectedResult>
</Plugin>
<Plugin>
  <PluginName>30.5 - NVIDIA Container Toolkit version</PluginName>
  <PluginDescription>Script item 30, sub-section 30.5. Source: gpu_baseline_check_2.sh:2761-2792 (main_30_33.sh:204-235). Version from nvidia-container-cli, nvidia-ctk, dpkg-query/rpm nvidia-container-toolkit. Not installed -&gt; INFO. &gt;= 1.19.1 -&gt; OK, below -&gt; FAIL. Verdict = worst result in this sub-section, FAIL &gt; WARN &gt; OK &gt; INFO; the WARN/FAIL lines the script adds to item 30's issues/warns are included. Gate (script lines 28-40): no /proc/driver/nvidia, no nvidia-smi, no /dev/nvidia[0-9]*, no NVIDIA 3D/VGA in lspci -&gt; 'n/a no NVIDIA GPU' (script: PASS, skip item 30). Output: '&lt;OK|INFO|WARN|FAIL|n/a&gt; &lt;observed&gt;'. WARN fails in Bitscan.</PluginDescription>
  <PluginId>40d83063-251d-4ade-ad02-9d2fcaa2ffc4</PluginId>
  <Execute timeout="60"><![CDATA[
_ver_num() { printf '%s\n' "${1:-}" | grep -oE '[0-9]+(\.[0-9]+)*' | head -1; }
_ver_ge() {
  _a=$(_ver_num "${1:-}"); _b=$(_ver_num "${2:-}")
  if [ -z "$_a" ] || [ -z "$_b" ]; then return 1; fi
  [ "$_a" = "$_b" ] && return 0
  [ "$(printf '%s\n%s\n' "$_a" "$_b" | sort -V | head -1)" = "$_b" ]
}
V=""; D=""
item() {
  case "$1" in
    FAIL) V=FAIL ;;
    WARN) [ "$V" = FAIL ] || V=WARN ;;
    OK) case "$V" in FAIL|WARN) ;; *) V=OK ;; esac ;;
    INFO) [ -n "$V" ] || V=INFO ;;
  esac
  [ -n "${2:-}" ] && D="${D:+$D; }$2"
  return 0
}
out() {
  if [ -z "$V" ]; then printf 'n/a %s\n' "$1" | tr -s ' '
  else printf '%s %s\n' "$V" "$(printf '%s' "$D" | tr '\n' ' ' | tr -s ' ')"; fi
}
has_gpu=false
if [ -d /proc/driver/nvidia ] || command -v nvidia-smi >/dev/null 2>&1; then has_gpu=true; fi
if ! $has_gpu; then
  for f in /dev/nvidia[0-9]*; do if [ -e "$f" ]; then has_gpu=true; break; fi; done
fi
if ! $has_gpu && lspci 2>/dev/null | grep -qi 'NVIDIA.*\(3D controller\|VGA compatible\)'; then has_gpu=true; fi
if ! $has_gpu; then echo "n/a no NVIDIA GPU"; exit 0; fi
nct_ver=""
if command -v nvidia-container-cli >/dev/null 2>&1; then
  nct_ver=$(nvidia-container-cli --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
fi
if [ -z "$nct_ver" ] && command -v nvidia-ctk >/dev/null 2>&1; then
  nct_ver=$(nvidia-ctk --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
fi
if [ -z "$nct_ver" ]; then
  if command -v dpkg-query >/dev/null 2>&1; then
    nct_ver=$(dpkg-query -W -f='${Version}' nvidia-container-toolkit 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
  elif command -v rpm >/dev/null 2>&1; then
    nct_ver=$(rpm -q --qf '%{VERSION}' nvidia-container-toolkit 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
  fi
fi
NCT_MIN="1.19.1"
if [ -z "$nct_ver" ]; then
  item INFO "nvidia-container-toolkit=not installed min=$NCT_MIN"
elif _ver_ge "$nct_ver" "$NCT_MIN"; then
  item OK "nvidia-container-toolkit=$nct_ver min=$NCT_MIN"
else
  item FAIL "nvidia-container-toolkit=$nct_ver min=$NCT_MIN"
fi
out "no result"
  ]]></Execute>
