  if [ -z "$_a" ] || [ -z "$_b" ]; then return 1; fi
  [ "$_a" = "$_b" ] && return 0
  [ "$(printf '%s\n%s\n' "$_a" "$_b" | sort -V | head -1)" = "$_b" ]
