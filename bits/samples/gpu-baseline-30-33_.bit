$sriov_found || item INFO "sriov=no VF on any PF"
if [ "$v1_total" -gt 0 ]; then
  if $sriov_found && [ "$vf_no_vlan" -gt 0 ]; then item FAIL "roce v1 gids=$v1_total with VFs lacking a PF VLAN"
  elif $sriov_found; then item WARN "roce v1 gids=$v1_total"
  else item INFO "roce v1 gids=$v1_total (kernel default; isolation relies on the switch VLAN)"; fi
else
  item OK "roce v1 gids=0 v2=$v2_total"
fi
end_sec 33.2 "no result"
# 33.3 RDMA netns isolation
ctr_rt=false
for s in /run/containerd/containerd.sock /run/docker.sock /var/run/docker.sock; do [ -S "$s" ] && ctr_rt=true; done
$in_container && ctr_rt=true
netns_mode=""
[ -r /sys/module/ib_core/parameters/netns_mode ] && netns_mode=$(cat /sys/module/ib_core/parameters/netns_mode 2>/dev/null)
case "$netns_mode" in
  0) item OK "ib_core netns_mode=0 (exclusive)" ;;
  1) if $ctr_rt; then item FAIL "ib_core netns_mode=1 (shared) with a container runtime"; else item INFO "ib_core netns_mode=1 (shared, no container runtime)"; fi ;;
  *)
    if command -v rdma >/dev/null 2>&1; then
      rdma_sys=$(rdma system show 2>/dev/null)
      if echo "$rdma_sys" | grep -qw exclusive; then item OK "rdma netns=exclusive"
      elif echo "$rdma_sys" | grep -qw shared; then if $ctr_rt; then item FAIL "rdma netns=shared with a container runtime"; else item INFO "rdma netns=shared (no container runtime)"; fi
      else item WARN "rdma netns=unconfirmed"; fi
    else
      item WARN "rdma netns=unconfirmed (no ib_core param, no rdma tool)"
    fi ;;
esac
if [ "$netns_mode" = "0" ]; then
  if grep -rqsE '^[[:space:]]*options[[:space:]]+ib_core.*netns_mode=0' /etc/modprobe.d/ 2>/dev/null; then item OK "netns_mode persisted in modprobe.d"
  else item WARN "netns_mode not persisted in modprobe.d"; fi
fi
if command -v rdma >/dev/null 2>&1; then
  qkey_line=$(rdma system show 2>/dev/null | grep -oE 'privileged-qkey[[:space:]]+(on|off)')
  if [ -n "$qkey_line" ]; then
    if echo "$qkey_line" | grep -qw on; then item WARN "privileged-qkey=on"
    else item OK "privileged-qkey=off"; fi
  fi
fi
end_sec 33.3 "no result"
